# Local development: use Neon's free tier (https://neon.tech) or a local Postgres.
# Format: postgresql://user:password@host:port/dbname?sslmode=require
# Neon requires sslmode=require; localhost typically does not.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ledger_core?schema=public"

# Vercel deployment: set DATABASE_URL in the Vercel project's
# Environment Variables (Settings → Environment Variables). The Neon
# integration sets this automatically when you link a Neon project.

# Only used by the companion repos (recon, revenue-rec). ledger-core has
# no AI calls at runtime — the substrate is deterministic.
# ANTHROPIC_API_KEY=""

# Optional. Required to enable POST /api/admin/reset on the live demo so
# random visitors can't reset it. If unset, the endpoint fails closed
# with a 503.
# Generate with: openssl rand -hex 32
# ADMIN_TOKEN=""
