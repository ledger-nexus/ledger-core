{
  "name": "ledger-core",
  "version": "0.2.0",
  "private": true,
  "description": "Universal accounting substrate — Layers 1 & 2 of a multi-book general ledger, exercised on QBO-grade SaaS data, schema-compatible with NetSuite/Intacct.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "demo": "tsx prisma/demo.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:invariants": "vitest run tests/invariants.test.ts",
    "test:seeded": "vitest run tests/seeded-company.test.ts",
    "test:property": "vitest run tests/property-based.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.4",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.5.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "fast-check": "^3.23.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
