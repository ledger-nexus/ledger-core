// ledger-core — Universal accounting substrate (Prisma schema)
//
// This schema implements Layers 1, 2, and the empty seams for Layers 3-6 of
// the universal accounting schema documented in docs/universal-schema.md.
//
//   Layer 1 — Posting substrate: Account, JournalEntry, JournalLine.
//             Identical for every source system.
//   Layer 2 — Master data: LegalEntity, Book, FiscalCalendar, Period,
//             Currency, FxRate, Party, PartyRole, Item.
//   Layer 3 — Dimension engine: Dimension, DimensionValue, DimensionSet,
//             DimensionSetValue. Tables exist, no values seeded.
//   Layer 4 — Document layer: PostingRule table only. Document tables
//             (invoice, bill, etc.) live in consumer repos (recon, revenue-rec).
//   Layer 5 — Custom fields: `extensions Json` on every entity + a
//             CustomFieldDefinition registry. No EAV.
//   Layer 6 — Lineage: source_system / source_record_id / source_payload /
//             mapping_version on every imported row. Wired from day one.
//
// LOCKED DECISIONS (do not re-litigate; see docs/universal-schema.md):
//   - Multi-book is committed. Pattern 2 (full parallel ledgers).
//   - book_id is on JournalEntry; period close is per (entity, book, period).
//   - No fixed dimension columns on JournalLine — use the dimension engine.
//   - Customers/Vendors/Employees collapse into one Party + party_role.
//   - Surrogate keys are generated UUIDs; source-system IDs live in lineage.
//   - Three currency amounts per line: transaction, functional, reporting.
//
// Prisma model names stay accountant-friendly (Account, JournalEntry,
// JournalLine). The @@map directives align SQL table names with the
// universal-schema vocabulary so direct Postgres queries match the spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// Multi-tenancy — Tenant + Membership + per-tenant API tokens
// =========================================================================
//
// A Tenant is the firm or company using ledger-nexus. Every domain row
// (LegalEntity, Account, JournalEntry, AR/AP/FA/Lease/RevenueContract,
// audit log, etc.) carries a tenantId so cross-tenant data is invisible
// by construction.
//
// See docs/multi-tenancy.md for what's tenant-scoped vs global and the
// migration strategy. Book, Currency, FxRate, and User are global — they
// don't carry tenantId. Everything else does.
//
// Token-tenant binding: internal HTTP endpoints map an INTERNAL_API_TOKEN
// to a single TenantApiToken row, which gives them their tenantId for
// the request. Each companion repo (recon, revenue-rec, integrations,
// fa-amort) has its own per-tenant token.

model Tenant {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String @unique // url-safe, e.g. "acme-co"
  name        String
  ownerUserId String @db.Uuid

  // ─── Billing (Stripe) ────────────────────────────────────────────────
  //
  // Three columns mirror the Stripe-side state so the app can render
  // a billing page without round-tripping to Stripe on every request.
  // The webhook (POST /api/billing/webhook) keeps them in sync; this
  // table is the read source-of-truth for "what plan am I on?".
  //
  // Null on all three = tenant has never gone through checkout (free
  // tier / pre-launch). After checkout completes Stripe fires
  // customer.subscription.created and the webhook fills these in.

  /// Stripe Customer id (cus_...). Set once on first checkout; reused
  /// for subsequent subscription / portal sessions.
  stripeCustomerId      String?  @unique
  /// Active subscription id (sub_...). Null when no active subscription.
  stripeSubscriptionId  String?  @unique
  /// Plan key (matches the Stripe Price lookup_key — "free", "starter",
  /// "growth", etc.). Hardcoded plan catalog lives in src/lib/billing/plans.ts.
  billingPlan           String?
  /// Stripe-reported status — "active", "trialing", "past_due", "canceled", etc.
  subscriptionStatus    String?
  /// End of the current billing period — used to show "renews on X"
  /// on the billing page. Mirrors stripe Subscription.current_period_end.
  currentPeriodEnd      DateTime?

  /// When true, journal entries posted by MEMBERS go to PENDING_APPROVAL
  /// instead of POSTED. An ADMIN+ must approve before the entry hits
  /// the ledger. Directly-posted entries by an ADMIN bypass the queue.
  ///
  /// Defaults to false for backwards compat with existing tenants.
  /// Toggle via /admin/team or the future /admin/settings page.
  requireJeApproval Boolean @default(false)

  /// Optional minimum entry total (sum of debit lines) above which
  /// requireJeApproval kicks in. Null means "every non-admin entry
  /// requires approval" (the original binary behavior). When set,
  /// entries whose total is BELOW this threshold post directly even
  /// with requireJeApproval=true — useful for tenants that want
  /// oversight on material entries (e.g. $1,000+) without queue-
  /// thrashing on petty cash. Comparison is in the entry's currency;
  /// ledger-core posts one currency per entry so cross-currency
  /// thresholds aren't a concern. Evaluated only when
  /// requireJeApproval=true.
  jeApprovalMinAmount Decimal? @db.Decimal(18, 4)

  /// Pending ownership transfer. When the current OWNER initiates a
  /// hand-off, these two columns record the target user + when the
  /// offer was made. The target must accept (Server Action gated on
  /// `currentUser.id === pendingOwnerTransferToUserId`) to swap;
  /// either side can cancel before that. Atomic swap rotates
  /// Tenant.ownerUserId + flips the OWNER/ADMIN roles on the two
  /// memberships in one $transaction. Null on both = no transfer
  /// pending. Initiator-only column to keep the schema thin — the
  /// initiator is always the current OWNER, so we recover it from
  /// ownerUserId at the moment the column is non-null.
  pendingOwnerTransferToUserId    String?   @db.Uuid
  pendingOwnerTransferInitiatedAt DateTime?

  /// Maximum Anthropic spend per calendar month, in USD.
  /// Enforced by the companion repos' AI Server Actions (recon's
  /// proposeMatches, revenue-rec's extractContract, fa-amort's
  /// classify-* actions) before they call the API. Null means
  /// "fall back to env default AI_TENANT_MONTHLY_CAP_USD"
  /// (defaults to 50 in companion-repo helpers). The cap is checked
  /// post-flight on the prior calls — i.e. if cumulative tenant
  /// spend this month already exceeds the cap, the next call is
  /// refused. A single call can push spend over the cap by its own
  /// cost; subsequent calls then refuse until the calendar rolls.
  monthlyAiSpendCapUsd Decimal? @db.Decimal(10, 2)

  memberships TenantMembership[]
  apiTokens   TenantApiToken[]

  // Backrefs from tenant-scoped domain models. Listed here so Prisma can
  // resolve the relations on the other side. Cascading delete is OFF by
  // default — soft delete is the intended path for tenant offboarding
  // (see docs/multi-tenancy.md "Open questions").
  legalEntities          LegalEntity[]
  fiscalCalendars        FiscalCalendar[]
  periods                Period[]
  periodCloses           PeriodClose[]
  parties                Party[]
  partyRoles             PartyRole[]
  items                  Item[]
  accounts               Account[]
  journalEntries         JournalEntry[]
  journalLines           JournalLine[]
  dimensions             Dimension[]
  dimensionValues        DimensionValue[]
  dimensionSets          DimensionSet[]
  postingRules           PostingRule[]
  customFieldDefinitions CustomFieldDefinition[]
  arOpenItems            ArOpenItem[]
  arApplications         ArApplication[]
  apOpenItems            ApOpenItem[]
  apApplications         ApApplication[]
  fixedAssets            FixedAsset[]
  leases                 Lease[]
  revenueContracts       RevenueContract[]
  queues                 Queue[]
  recordEvents           RecordEvent[]
  auditLogs              AuditLog[]
  reassignmentRules      ReassignmentRule[]
  notifications          Notification[]
  recurringEntries       RecurringEntry[]
  journalEntryNotes      JournalEntryNote[]
  invites                TenantInvite[]
  emailDeliveries        EmailDelivery[]
  aiUsageReports         AiUsageReport[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@index([ownerUserId])
  @@map("tenant")
}

model TenantMembership {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String     @db.Uuid
  userId   String     @db.Uuid
  role     TenantRole @default(MEMBER)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_membership")
}

enum TenantRole {
  OWNER  // cannot be removed; can delete the tenant + change billing
  ADMIN  // full read+write+admin (period close, user lifecycle, AI budget config)
  MEMBER // read+write, no admin actions (the default for new members)
  VIEWER // read-only; cannot post JEs, approve AI suggestions, or run mutations
}

/// Outstanding invitation to a tenant. Created by an OWNER/ADMIN when
/// they invite an email address. The invite holds a randomly-generated
/// token used in the accept link (e-mailed if email is configured;
/// surfaced in the UI otherwise so dev / no-mailer setups still work).
///
/// Lifecycle:
///   - Created with status=PENDING + a token
///   - Sender's email service (or the admin manually) sends the
///     invite URL: /invites/accept?token=<token>
///   - Recipient signs in / signs up; the accept handler verifies the
///     token + email match, creates the TenantMembership with the
///     stored role, marks the invite ACCEPTED.
///   - Admin can REVOKE (no longer accepts the link) before acceptance.
///   - Invites auto-expire after expiresAt (default: 14 days).
model TenantInvite {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Email the invite was sent to. Lowercased on insert. The accept
  /// flow refuses if the signed-in user's primary email != this value
  /// (case-insensitively), so the invite can't be hijacked.
  email       String
  /// SOC 2 CC6 — Confidentiality TSC. HMAC-SHA256 search-hash for the
  /// encrypted email column. Populated by the encrypted-fields Prisma
  /// extension on write; queried by `emailLookupKeyForTenantInvite`
  /// at the team.ts:114 duplicate-invite refusal site. See
  /// docs/design/deterministic-encryption.md (Phase 3).
  ///
  /// Nullable during the rollout window so existing pre-rollout rows
  /// don't block writes. Composite index with tenantId for the per-
  /// tenant duplicate check.
  emailHash   Bytes?
  /// Role assigned on acceptance. OWNER is intentionally not invitable
  /// — there is one OWNER per tenant and it's set at tenant creation.
  role        TenantRole
  /// Random URL-safe token. Stored as-is (not hashed) because acceptance
  /// is a single-use action and the token only lets the holder JOIN
  /// the tenant, not impersonate an existing member. If invites start
  /// granting broader scope, switch to hashed-at-rest.
  token       String       @unique
  status      InviteStatus @default(PENDING)
  /// Who created the invite. Tracks the originator for audit.
  invitedById String       @db.Uuid
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?
  revokedAt   DateTime?

  @@index([tenantId, status])
  // The legacy @@index([email, status]) covered the duplicate-invite
  // refusal at team.ts:114. With email now encrypted (random IV →
  // useless for lookup), the equivalent index is on emailHash. Both
  // are kept during the rollout window so pre-migrated rows are still
  // findable; the legacy one can be dropped in a cleanup PR after
  // every row has emailHash populated.
  @@index([email, status])
  @@index([tenantId, emailHash])
  @@map("tenant_invite")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Audit trail for outbound transactional email. Every send attempt
/// (real or logged-only) writes a row so the operator can answer
/// "did this customer actually get their invite?".
///
/// The provider is Resend today via src/lib/email/send.ts. When
/// RESEND_API_KEY is unset (dev / staging-without-mailer), status
/// is LOGGED_ONLY and the email body is preserved so the operator
/// can still hand-deliver if needed.
model EmailDelivery {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Tenant the email is on behalf of. Null for platform-level
  /// emails (no current tenant context).
  tenantId      String?             @db.Uuid
  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  toEmail       String
  /// Stable template identifier — "tenant_invite", "period_close_reminder",
  /// "ai_spend_warning", etc. Lets us answer "how many invites went
  /// out this week?" without parsing subjects.
  template      String
  subject       String
  bodyText      String?
  bodyHtml      String?
  status        EmailDeliveryStatus
  /// Provider message id (Resend's response.id when DELIVERED).
  providerId    String?
  errorMessage  String?
  /// Template-specific payload (inviteId, jeId, etc.).
  metadata      Json?
  sentAt        DateTime            @default(now())

  @@index([tenantId, sentAt])
  @@index([toEmail, sentAt])
  @@map("email_delivery")
}

enum EmailDeliveryStatus {
  DELIVERED    // Provider accepted the message
  LOGGED_ONLY  // No RESEND_API_KEY set; row persisted for visibility
  FAILED       // Provider rejected (rate limit, bad recipient, etc.)
}

/// Daily report of AI token spend to Stripe's billing-meter API.
/// One row per (tenant, usageDay) — the unique constraint dedupes
/// retries so a cron that runs twice in one day doesn't double-bill.
///
/// Reports are in CENTS of our Anthropic cost. The Stripe Meter +
/// Price configuration (in the Stripe dashboard) decides the markup —
/// the typical setup is "$1 per 100 units" (pass-through), but the
/// operator can set "$1 per 50 units" (2x markup) or any other ratio.
///
/// See docs/billing-setup.md for the operator runbook on configuring
/// the Stripe Meter + Price.
model AiUsageReport {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                @db.Uuid
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD" (UTC). The calendar day the usage was for.
  usageDay        String
  /// Cents of Anthropic cost summed across all 3 AI suggestion tables
  /// for this tenant on this usageDay. Zero is reported when there's
  /// no usage (status=NO_USAGE) so the cron's progress is visible.
  reportedCents   Int
  /// Stripe meter event id (response.identifier when DELIVERED).
  stripeEventId   String?
  status          AiUsageReportStatus
  errorMessage    String?
  reportedAt      DateTime              @default(now())

  @@unique([tenantId, usageDay])
  @@index([tenantId, reportedAt])
  @@map("ai_usage_report")
}

enum AiUsageReportStatus {
  REPORTED         // Stripe accepted the meter event
  NO_USAGE         // Tenant had zero AI cost that day (row persisted so cron progress is visible)
  NO_SUBSCRIPTION  // Tenant has no stripeSubscriptionId (free tier — nothing to bill)
  LOGGED_ONLY      // STRIPE_SECRET_KEY unset; row persisted for visibility but no Stripe call made
  FAILED           // Stripe rejected (meter not configured, customer not found, etc.)
}

// Per-tenant API tokens for companion-repo authentication.
//
// Each repo (recon, revenue-rec, integrations, fa-amort) holds its
// tenant's token in its Vercel env. ledger-core hashes incoming
// Authorization Bearer values and looks them up here to resolve the
// tenantId for the request. lastUsedAt is updated on every successful
// auth; revokedAt cuts off the token.
//
// label is a short human-readable identifier so the audit log shows
// "recon-prod" instead of an opaque token ID.
model TenantApiToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // sha256 of the plaintext token
  label      String // e.g. "recon-prod", "fa-amort-staging"
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([tenantId])
  @@map("tenant_api_token")
}

// =========================================================================
// Layer 2 — Master Data
// =========================================================================

model LegalEntity {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // tenantId is nullable during migration (Phase 1); Phase 4 backfills
  // remaining rows, scopes all queries, and applies NOT NULL.
  tenantId       String        @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Phase 4b: code is unique PER tenant. Two tenants can both own
  // an entity coded "ACME" — collisions are isolated by tenantId.
  code           String
  name           String
  parentEntityId String?       @db.Uuid
  parent         LegalEntity?  @relation("EntityHierarchy", fields: [parentEntityId], references: [id])
  children       LegalEntity[] @relation("EntityHierarchy")

  // The currency this entity reports in. Each book may override for reporting.
  functionalCurrencyId String
  functionalCurrency   Currency @relation("EntityFunctionalCcy", fields: [functionalCurrencyId], references: [code])

  // Lineage — null for natively-created entities; populated on ERP import.
  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  fiscalCalendars  FiscalCalendar[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  parties          Party[]
  items            Item[]
  periodCloses     PeriodClose[]
  fixedAssets      FixedAsset[]
  leases           Lease[]
  revenueContracts RevenueContract[]
  arOpenItems      ArOpenItem[]
  apOpenItems      ApOpenItem[]
  recurringEntries RecurringEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("legal_entity")
}

model Book {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String    @unique // e.g. "US_GAAP", "US_TAX", "IFRS", "MGMT"
  name                String
  // The accounting basis. Drives default behavior in posting rules + reports.
  basis               BookBasis
  // Reporting currency for THIS book. Functional currency lives on LegalEntity.
  // Permits e.g. a US entity with a USD functional ledger but an EUR-reported IFRS book.
  reportingCurrencyId String
  reportingCurrency   Currency  @relation("BookReportingCcy", fields: [reportingCurrencyId], references: [code])

  isActive   Boolean @default(true)
  extensions Json?

  journalEntries                JournalEntry[]
  periodCloses                  PeriodClose[]
  postingRules                  PostingRule[]
  fixedAssetBookAttributes      FixedAssetBookAttributes[]
  leaseBookAttributes           LeaseBookAttributes[]
  revenueContractBookAttributes RevenueContractBookAttributes[]
  arOpenItems                   ArOpenItem[]
  apOpenItems                   ApOpenItem[]
  recurringEntries              RecurringEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("book")
}

enum BookBasis {
  US_GAAP
  US_TAX
  IFRS
  MGMT
  STATUTORY
}

model FiscalCalendar {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId        String          @db.Uuid
  entity          LegalEntity     @relation(fields: [entityId], references: [id])
  code            String // e.g. "STANDARD_2026"
  name            String
  periodFrequency PeriodFrequency @default(MONTHLY)

  periods Period[]

  createdAt DateTime @default(now())

  @@unique([entityId, code])
  @@index([tenantId])
  @@map("fiscal_calendar")
}

enum PeriodFrequency {
  MONTHLY
  QUARTERLY
  WEEKLY_4_4_5
  WEEKLY_4_5_4
  WEEKLY_5_4_4
  CUSTOM
}

model Period {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String         @db.Uuid
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  calendarId String         @db.Uuid
  calendar   FiscalCalendar @relation(fields: [calendarId], references: [id])
  code       String // e.g. "2026-01", "2026-Q1"
  ordinal    Int // 1..12 for monthly, 1..52 for weekly
  startsOn   DateTime       @db.Date
  endsOn     DateTime       @db.Date

  journalEntries JournalEntry[]
  closes         PeriodClose[]

  @@unique([calendarId, code])
  @@unique([calendarId, ordinal])
  @@index([startsOn, endsOn])
  @@index([tenantId])
  @@map("period")
}

// Close locks are per (entity, book, period) — GAAP April can be closed while
// Tax April stays open. The posting function refuses writes against closed
// (entity, book, period) tuples.
model PeriodClose {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])
  periodId String      @db.Uuid
  period   Period      @relation(fields: [periodId], references: [id])
  closedAt DateTime    @default(now())
  closedBy String?

  @@unique([entityId, bookId, periodId])
  @@index([tenantId])
  @@map("period_close")
}

model Currency {
  // ISO 4217 code is the primary key — these are stable.
  code     String  @id // "USD", "EUR", "JPY"
  name     String
  decimals Int     @default(2) // 2 for USD, 0 for JPY, etc.
  symbol   String?

  fxRatesFrom        FxRate[]          @relation("FxFrom")
  fxRatesTo          FxRate[]          @relation("FxTo")
  entitiesFunctional LegalEntity[]     @relation("EntityFunctionalCcy")
  booksReporting     Book[]            @relation("BookReportingCcy")
  journalEntries     JournalEntry[]    @relation("JeCurrency")
  linesTxn           JournalLine[]     @relation("LineTxnCcy")
  linesReporting     JournalLine[]     @relation("LineReportingCcy")
  fixedAssets        FixedAsset[]      @relation("FixedAssetAcqCcy")
  leases             Lease[]           @relation("LeaseCcy")
  revenueContracts   RevenueContract[] @relation("RevContractCcy")
  recurringEntries   RecurringEntry[]

  @@map("currency")
}

model FxRate {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromCurrencyId String
  toCurrencyId   String
  fromCurrency   Currency   @relation("FxFrom", fields: [fromCurrencyId], references: [code])
  toCurrency     Currency   @relation("FxTo", fields: [toCurrencyId], references: [code])
  asOf           DateTime   @db.Date
  rate           Decimal    @db.Decimal(20, 10)
  rateType       FxRateType @default(SPOT)

  @@unique([fromCurrencyId, toCurrencyId, asOf, rateType])
  @@index([asOf])
  @@map("fx_rate")
}

enum FxRateType {
  SPOT
  AVG // period-average rate (used for revenue/expense translation)
  CLOSE // period-close rate (used for balance-sheet translation)
  HISTORICAL // rate at a specific point (used for equity translation)
}

model Party {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId    String?      @db.Uuid // null = shared across entities
  entity      LegalEntity? @relation(fields: [entityId], references: [id])
  code        String // human-readable, often source-system code
  displayName String

  // Customer:Job / Project / WBS / Sage Job all collapse to one Party with parent.
  // Per spec anti-pattern list: do NOT model jobs as a kind of customer.
  parentPartyId String? @db.Uuid
  parent        Party?  @relation("PartyHierarchy", fields: [parentPartyId], references: [id])
  children      Party[] @relation("PartyHierarchy")

  roles             PartyRole[]
  journalLines      JournalLine[]
  vendorFixedAssets FixedAsset[]      @relation("FixedAssetVendor")
  lessorLeases      Lease[]           @relation("LeaseLessor")
  customerContracts RevenueContract[] @relation("ContractCustomer")
  arOpenItems       ArOpenItem[]
  apOpenItems       ApOpenItem[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([tenantId])
  @@map("party")
}

model PartyRole {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String        @db.Uuid
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  partyId  String        @db.Uuid
  party    Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  role     PartyRoleKind
  startsOn DateTime?     @db.Date
  endsOn   DateTime?     @db.Date

  @@unique([partyId, role])
  @@index([tenantId])
  @@map("party_role")
}

enum PartyRoleKind {
  CUSTOMER
  VENDOR
  EMPLOYEE
  OTHER
}

model Item {
  id                          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                    String         @db.Uuid
  tenant                      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId                    String?        @db.Uuid
  entity                      LegalEntity?   @relation(fields: [entityId], references: [id])
  code                        String
  name                        String
  itemType                    ItemType       @default(SERVICE)
  costingMethod               CostingMethod?
  defaultIncomeAccountCode    String?
  defaultExpenseAccountCode   String?
  defaultInventoryAccountCode String?

  journalLines JournalLine[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([tenantId])
  @@map("item")
}

enum ItemType {
  INVENTORY
  NON_INVENTORY
  SERVICE
  KIT
  ASSEMBLY
  FIXED_ASSET
}

enum CostingMethod {
  FIFO
  LIFO
  AVERAGE
  STANDARD
  SPECIFIC
}

// =========================================================================
// Layer 1 — Posting Substrate
// =========================================================================

model Account {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // entityId null = shared across all entities (consolidated chart).
  // Set to a value = entity-specific account.
  entityId String?      @db.Uuid
  entity   LegalEntity? @relation(fields: [entityId], references: [id])

  // Human-readable code (e.g. "1000" for Cash). NOT a source-system primary key.
  // Convention: 1xxx Assets, 2xxx Liabilities, 3xxx Equity, 4xxx Revenue, 5xxx-9xxx Expenses.
  code             String
  name             String
  type             AccountType
  normalBalance    NormalBalance
  subtype          String? // e.g. "CASH", "AR_TRADE", "INVENTORY_RAW"
  isContra         Boolean       @default(false)
  isControlAccount Boolean       @default(false) // true for AR/AP control accounts
  isBank           Boolean       @default(false)

  parentAccountId String?   @db.Uuid
  parent          Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children        Account[] @relation("AccountHierarchy")

  // Books this account applies to. Empty = applies to all books.
  // e.g. ["US_TAX"] for a tax-only account; empty for a normal account.
  bookScope String[] @default([])

  active Boolean @default(true)

  lines JournalLine[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([type])
  @@index([tenantId])
  @@map("account")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// One row per posted document. Posts to exactly ONE (entity, book).
// Multi-book postings of a single source event create N JournalEntry rows
// (one per book), all sharing the same source_record_id in lineage.
model JournalEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // entryNumber is a human-readable sequential ID, unique per (entity, book).
  // Format: ENTITY-BOOK-NNNNN (e.g. NORTHWIND-US_GAAP-00001).
  // Phase 4b: unique per [tenantId, entryNumber] — each tenant can have
  // its own NORTHWIND-US_GAAP-00001 without colliding.
  entryNumber String

  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])

  // periodId is resolved at posting time from the document/posting date and
  // the entity's fiscal calendar. Null only allowed for entries dated before
  // any defined period (historical pre-go-live data).
  periodId String? @db.Uuid
  period   Period? @relation(fields: [periodId], references: [id])

  // Document date = when the transaction is dated (invoice date).
  // Posting date = when it hit the ledger (often same; can differ for backdated entries).
  documentDate DateTime @db.Date
  postingDate  DateTime @db.Date

  memo String

  // Header currency = the transaction's natural currency. fxRate translates
  // it to the book's reporting currency. Per-line currency is allowed in
  // edge cases (intercompany) but defaults to the header.
  currencyId String
  currency   Currency @relation("JeCurrency", fields: [currencyId], references: [code])
  fxRate     Decimal  @default(1) @db.Decimal(20, 10)

  source JournalSource @default(MANUAL)
  status EntryStatus   @default(POSTED)

  reversalOfId String?        @db.Uuid
  reversalOf   JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry[] @relation("Reversal")

  // Lineage — non-negotiable per spec. Populated on every ERP import.
  sourceSystem     String? // "QBO", "NETSUITE", "INTACCT", ...
  sourceRecordType String? // "Invoice", "Bill", "JournalEntry", ...
  sourceRecordId   String? // the source system's ID (NEVER reused as our PK)
  sourcePayload    Json? // frozen raw original
  mappingVersion   String?
  extensions       Json?

  lines JournalLine[]

  // Sub-ledger backrefs — entries that opened or applied to sub-ledger items.
  arOpenItemsOpened ArOpenItem[]    @relation("ArOpenedBy")
  apOpenItemsOpened ApOpenItem[]    @relation("ApOpenedBy")
  arApplications    ArApplication[] @relation("ArAppliedBy")
  apApplications    ApApplication[] @relation("ApAppliedBy")

  // Ownership + audit. ownerId is the default-responsible-party; defaults to
  // createdBy at insert and only changes via explicit reassignment (manual or
  // rule-fired). In ERP modules, ownerId is informational/workflow — module
  // permissions handle access control, NOT this field. See
  // docs/ownership-and-rules.md for the full semantic.
  ownerId              String?   @db.Uuid
  ownerType            OwnerType @default(USER)
  updatedBy            String?
  updatedAt            DateTime  @default(now()) @updatedAt
  // When set, the reassignment-rules engine SKIPS this record. Cleared
  // explicitly by an admin or by a state transition; never auto-cleared.
  reassignmentLockedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?

  // ─── Maker-checker approval columns ────────────────────────────────
  //
  // Populated only for entries that flow through the approval queue.
  // Direct ADMIN postings leave these null. submittedById is the User
  // who clicked "Submit for approval" (typically the maker); the
  // approval / rejection columns are set when an ADMIN+ resolves it.
  //
  // rejectionReason is required when status flips to VOID via the
  // reject action; null when VOID came from a different code path
  // (e.g. an offsetting cancellation).
  submittedById   String?   @db.Uuid
  submittedAt     DateTime?
  approvedById    String?   @db.Uuid
  approvedAt      DateTime?
  rejectedById    String?   @db.Uuid
  rejectedAt      DateTime?
  rejectionReason String?

  // Backref to ownership events.
  recordEvents RecordEvent[] @relation("JournalEntryEvents")

  // Backref to inline notes (review comments, follow-up flags).
  notes JournalEntryNote[]

  @@unique([tenantId, entryNumber])
  @@index([ownerId])
  @@index([entityId, bookId, documentDate])
  @@index([entityId, bookId, periodId])
  @@index([sourceSystem, sourceRecordType, sourceRecordId])
  @@index([tenantId, postingDate])
  @@index([tenantId, status, createdAt])
  @@map("gl_entry_header")
}

enum JournalSource {
  MANUAL // entered by a human via the UI
  SEED // loaded from seed data
  SYSTEM // posted by another module (e.g. rev rec engine)
  AI_APPROVED // AI suggested, human approved (used in recon project)
  IMPORT // ERP import (companion to source_system lineage)
}

enum EntryStatus {
  DRAFT             // never submitted; never appears in reports
  PENDING_APPROVAL  // submitted for maker-checker review; never appears in reports
  POSTED            // approved (or directly posted by an admin); appears in reports
  VOID              // never reverses an existing posting; used for rejected pending entries too
  REVERSED          // an offsetting POSTED entry was cut against this one
}

model JournalLine {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // tenantId denormalized from the parent JournalEntry for query speed.
  // Always equals entry.tenantId; enforced in postJournalEntry.
  tenantId  String       @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entryId   String       @db.Uuid
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  lineNo    Int // 1-based, position within entry
  accountId String       @db.Uuid
  account   Account      @relation(fields: [accountId], references: [id])

  // Sub-ledger keys — nullable. When populated, the entry contributes to a
  // sub-ledger lifecycle (e.g. partyId set on an AR line opens/applies an
  // AR open item). The open-item tables themselves arrive in the next batch.
  partyId String? @db.Uuid
  party   Party?  @relation(fields: [partyId], references: [id])
  itemId  String? @db.Uuid
  item    Item?   @relation(fields: [itemId], references: [id])

  // Layer 3 — dimension engine. Nullable until the first ERP import that
  // carries class/department/location dimensions.
  dimensionSetId String?       @db.Uuid
  dimensionSet   DimensionSet? @relation(fields: [dimensionSetId], references: [id])

  // taxCodeId — slot. TaxCode table arrives with the document layer in a
  // consumer repo. String form here to avoid a meaningless empty table now.
  taxCodeId String?

  // The canonical debit/credit pair in the BOOK's reporting currency.
  // XOR constraint enforced at the DB layer (migration SQL).
  debit  Decimal @default(0) @db.Decimal(18, 4)
  credit Decimal @default(0) @db.Decimal(18, 4)

  // Transaction-currency view (signed: debit positive, credit negative).
  // = (debit - credit) for single-currency. Diverges when the line is in
  // a non-functional currency (intercompany, FX gains/losses).
  transactionAmount     Decimal   @default(0) @db.Decimal(18, 4)
  transactionCurrencyId String?
  transactionCurrency   Currency? @relation("LineTxnCcy", fields: [transactionCurrencyId], references: [code])

  // Reporting-currency view (signed). Equals functional when the book's
  // reporting currency = the entity's functional currency.
  reportingAmount     Decimal   @default(0) @db.Decimal(18, 4)
  reportingCurrencyId String?
  reportingCurrency   Currency? @relation("LineReportingCcy", fields: [reportingCurrencyId], references: [code])

  description String?
  extensions  Json?

  @@unique([entryId, lineNo])
  @@index([entryId])
  @@index([accountId])
  @@index([partyId])
  @@index([tenantId])
  @@map("gl_entry_line")
}

// =========================================================================
// Journal entry notes (inline review comments)
// =========================================================================
// A lightweight comment thread on a JE. Real workflow: one CPA reviews the
// month, flags "verify this accrual" on an entry; another CPA sees the
// note on their next pass and either fixes the entry, posts an adjustment,
// or resolves the note.
//
// Notes do NOT change the entry's lines. They're metadata for human review.
// Resolving a note is a soft state — the note stays visible (audit) but
// renders de-emphasized. Deleting is admin-only.

model JournalEntryNote {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @db.Uuid
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entryId      String       @db.Uuid
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  // Author: links to User but kept nullable for the case where a user
  // is later deactivated. authorEmail is snapshotted at write time so
  // the note's authorship survives even if the user row goes away.
  authorUserId String?      @db.Uuid
  author       User?        @relation(fields: [authorUserId], references: [id])
  authorEmail  String?

  // Plain-text body for v1. No markdown / no rich text — keeps the audit
  // surface clean. CPAs write short prose.
  body String

  // Resolution: anyone in the tenant can resolve. The note stays in the
  // DB; the UI renders resolved notes muted.
  resolvedAt    DateTime?
  resolvedBy    String? // email snapshot (same rationale as authorEmail)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryId])
  @@index([tenantId])
  @@index([resolvedAt])
  @@map("journal_entry_note")
}

// =========================================================================
// Recurring journal entries
// =========================================================================
// Templates for predictable, schedule-driven entries (monthly rent, SaaS
// subscriptions, accruals). Each template carries a fixed shape (lines)
// plus a cadence. A nightly / on-demand `runRecurringEntries` pass walks
// active templates, computes which periods haven't yet been posted, and
// fires postJournalEntry for each — with a stable lineage triple so
// re-running is idempotent.
//
// The template is NOT a journal entry. It produces journal entries.
// Editing or deleting a template does NOT touch entries already posted;
// they're real history. Deactivating a template stops it from producing
// new entries.

model RecurringEntry {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String @db.Uuid
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId  String @db.Uuid
  entity    LegalEntity @relation(fields: [entityId], references: [id])
  bookId    String @db.Uuid
  book      Book   @relation(fields: [bookId], references: [id])

  // Human-readable identifier per tenant. "MONTHLY_RENT", "QUARTERLY_AUDIT_ACCRUAL".
  code String
  memo String

  // Header currency for the produced entries. Lines are signed-quantity;
  // the JE picks up fxRate from the rate table at posting time.
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [code])

  cadence Cadence

  // First posting date. The first JE produced is dated startDate.
  // For monthly cadence, subsequent JEs are at startDate + N months
  // (anchored to startDate's day-of-month; falls back to last day of
  // month if the target month is shorter).
  startDate DateTime @db.Date
  // Optional sunset: no posts after endDate (inclusive). Null = forever.
  endDate   DateTime? @db.Date
  // Bookmark: the most recent docDate this template successfully posted.
  // Drives "what's next" — next posting is the cadence step AFTER this.
  // Null = never posted; the first post will use startDate.
  lastPostedDate DateTime? @db.Date

  // When false, the runner skips this template (kept for history / re-enable).
  isActive Boolean @default(true)

  lines RecurringEntryLine[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([entityId, bookId])
  @@map("recurring_entry")
}

model RecurringEntryLine {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String @db.Uuid
  template   RecurringEntry @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // 1-indexed within the template.
  lineNo Int

  // Account code resolved at post time against the entity's chart.
  accountCode String

  // Money. Mirrors the substrate convention (debit XOR credit > 0).
  debit  Decimal @db.Decimal(18, 4) @default(0)
  credit Decimal @db.Decimal(18, 4) @default(0)

  description String?
  partyCode   String?
  itemCode    String?

  @@unique([templateId, lineNo])
  @@map("recurring_entry_line")
}

enum Cadence {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

// =========================================================================
// Layer 3 — Dimension Engine
// =========================================================================
// Tables defined; no values seeded in v1. Adding a value here is free —
// no schema change. This is why fixed dimension columns on JournalLine are
// an anti-pattern.

model Dimension {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String  @db.Uuid
  tenant                Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Phase 4b: unique per tenant so each tenant defines their own CLASS.
  code                  String // "DEPARTMENT", "CLASS", "LOCATION", "PROJECT"
  name                  String
  // Optional free-form descriptive blurb. Preserved across mapper
  // roundtrips so NS custom-segment definitions survive export/import.
  // Not consumed by the GL engine.
  description           String?
  isRequired            Boolean @default(false)
  // JSON array of AccountType strings this dimension applies to.
  // e.g. ["REVENUE", "EXPENSE"] for P&L-only dimensions.
  appliesToAccountTypes Json    @default("[]")

  values  DimensionValue[]
  bridges DimensionSetValue[]

  createdAt DateTime @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("dimension")
}

model DimensionValue {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dimensionId String    @db.Uuid
  dimension   Dimension @relation(fields: [dimensionId], references: [id])
  code        String
  name        String

  bridges DimensionSetValue[]

  @@unique([dimensionId, code])
  @@index([tenantId])
  @@map("dimension_value")
}

// A deduplicated combination of dimension values. Each JournalLine references
// one DimensionSet. Two lines with identical (Department=ENG, Class=R&D)
// share the same DimensionSet row.
model DimensionSet {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Stable hash of sorted (dimensionId, dimensionValueId) pairs. Used for
  // dedup lookups during posting. Phase 4b: unique per [tenantId, hash]
  // so identical assignments in different tenants don't collide.
  hash     String

  values       DimensionSetValue[]
  journalLines JournalLine[]

  createdAt DateTime @default(now())

  @@unique([tenantId, hash])
  @@index([tenantId])
  @@map("dimension_set")
}

model DimensionSetValue {
  dimensionSetId   String         @db.Uuid
  dimensionId      String         @db.Uuid
  dimensionValueId String         @db.Uuid
  dimensionSet     DimensionSet   @relation(fields: [dimensionSetId], references: [id], onDelete: Cascade)
  dimension        Dimension      @relation(fields: [dimensionId], references: [id])
  dimensionValue   DimensionValue @relation(fields: [dimensionValueId], references: [id])

  @@id([dimensionSetId, dimensionId])
  @@map("dimension_set_value")
}

// =========================================================================
// Layer 4 — Posting Rules (table only; no rules registered in v1)
// =========================================================================
// A source event (e.g. NetSuite "Customer Invoice") maps to N GL-line
// templates, one per applicable book. With no rules registered, the posting
// function falls back to "post identically to every active book."

model PostingRule {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @db.Uuid
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceEventType String // e.g. "QBO_INVOICE"
  bookId          String  @db.Uuid
  book            Book    @relation(fields: [bookId], references: [id])
  ruleVersion     Int     @default(1)
  // GL-line template — accounts, signs, dimension mappings, etc.
  // Schema TBD when the first rule is authored.
  template        Json
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceEventType, bookId, ruleVersion])
  @@index([tenantId])
  @@map("posting_rule")
}

// =========================================================================
// Layer 5 — Custom Field Metadata
// =========================================================================
// The JSON content lives in `extensions` on each entity. THIS table just
// describes what's inside those JSON blobs so a UI can render forms and
// queries can use GIN indexes intelligently.

model CustomFieldDefinition {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @db.Uuid
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Which entity type this field attaches to ("party", "account", "item",
  // "gl_entry_header", "gl_entry_line", "invoice", ...).
  targetEntityType String
  fieldKey         String // key inside the extensions JSON
  label            String
  fieldType        CustomFieldType
  validation       Json? // e.g. { min: 0, max: 100 } or { regex: "^[A-Z]{2}$" }
  defaultValue     Json?
  sourceErpField   String? // original ERP field code (for round-trip)

  createdAt DateTime @default(now())

  @@unique([targetEntityType, fieldKey])
  @@index([tenantId])
  @@map("custom_field_definition")
}

enum CustomFieldType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  ENUM
  REFERENCE
  JSON_VALUE
}

// =========================================================================
// Native Sub-Ledgers — owned, not delegated to specialty tools.
// =========================================================================
// Per the spec's "Own sub-ledgers natively" decision: AR/AP open-item
// lifecycles + fixed assets + leases + revenue contracts live HERE, not in
// Sage FAS / LeaseQuery / Zuora. Each has a book-aware attributes table
// keyed by (record_id, book_id) so the same physical asset/lease/contract
// can carry divergent useful life / classification / recognition timing
// across US_GAAP, US_TAX, and IFRS — the engine for book-tax differences.

// ---- AR (Accounts Receivable) -------------------------------------------
// A bill creates an AP open item; it is NOT itself AP. An invoice opens an
// AR open item; payments APPLY to the item; full application closes it.
// Sum of currentBalance for OPEN items per (entity, book) = AR control
// account balance (the invariant).

model ArOpenItem {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])
  partyId  String      @db.Uuid
  party    Party       @relation(fields: [partyId], references: [id])

  // The JournalEntry that opened this item (typically an invoice).
  openedByEntryId String       @db.Uuid
  openedByEntry   JournalEntry @relation("ArOpenedBy", fields: [openedByEntryId], references: [id])

  referenceNumber    String? // invoice number from the source system
  openedDate         DateTime       @db.Date
  dueDate            DateTime?      @db.Date
  originalAmount     Decimal        @db.Decimal(18, 4)
  currentBalance     Decimal        @db.Decimal(18, 4)
  currencyId         String
  status             OpenItemStatus @default(OPEN)
  // Which AR control account this rolls up to (denormalized for the
  // sum-of-open = control-balance invariant query).
  controlAccountCode String

  applications ArApplication[]

  // Ownership + audit. Same semantics as JournalEntry — see
  // docs/ownership-and-rules.md. ownerId is workflow-routing (which
  // collector is responsible), NOT access control.
  ownerId              String?   @db.Uuid
  ownerType            OwnerType @default(USER)
  createdBy            String?
  updatedBy            String?
  reassignmentLockedAt DateTime?

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Backref to RecordEvent audit log.
  recordEvents RecordEvent[] @relation("ArOpenItemEvents")

  @@index([ownerId])
  @@index([entityId, bookId, partyId, status])
  @@index([entityId, bookId, status, dueDate])
  @@index([tenantId])
  @@map("ar_open_item")
}

enum OpenItemStatus {
  OPEN
  PARTIAL
  APPLIED
  WRITTEN_OFF
  REOPENED
  VOID
}

model ArApplication {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @db.Uuid
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  openItemId       String       @db.Uuid
  openItem         ArOpenItem   @relation(fields: [openItemId], references: [id], onDelete: Cascade)
  appliedByEntryId String       @db.Uuid
  appliedByEntry   JournalEntry @relation("ArAppliedBy", fields: [appliedByEntryId], references: [id])
  appliedAmount    Decimal      @db.Decimal(18, 4)
  appliedDate      DateTime     @db.Date

  createdAt DateTime @default(now())

  @@index([openItemId])
  @@index([tenantId])
  @@map("ar_application")
}

// ---- AP (Accounts Payable) — mirror of AR -------------------------------

model ApOpenItem {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])
  partyId  String      @db.Uuid
  party    Party       @relation(fields: [partyId], references: [id])

  openedByEntryId String       @db.Uuid
  openedByEntry   JournalEntry @relation("ApOpenedBy", fields: [openedByEntryId], references: [id])

  referenceNumber    String?
  openedDate         DateTime       @db.Date
  dueDate            DateTime?      @db.Date
  originalAmount     Decimal        @db.Decimal(18, 4)
  currentBalance     Decimal        @db.Decimal(18, 4)
  currencyId         String
  status             OpenItemStatus @default(OPEN)
  controlAccountCode String

  applications ApApplication[]

  // Ownership + audit. Same semantics as ArOpenItem / JournalEntry — see
  // docs/ownership-and-rules.md. AP collector / approval workflow uses this.
  ownerId              String?   @db.Uuid
  ownerType            OwnerType @default(USER)
  createdBy            String?
  updatedBy            String?
  reassignmentLockedAt DateTime?

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Backref to RecordEvent audit log.
  recordEvents RecordEvent[] @relation("ApOpenItemEvents")

  @@index([ownerId])
  @@index([entityId, bookId, partyId, status])
  @@index([entityId, bookId, status, dueDate])
  @@index([tenantId])
  @@map("ap_open_item")
}

model ApApplication {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @db.Uuid
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  openItemId       String       @db.Uuid
  openItem         ApOpenItem   @relation(fields: [openItemId], references: [id], onDelete: Cascade)
  appliedByEntryId String       @db.Uuid
  appliedByEntry   JournalEntry @relation("ApAppliedBy", fields: [appliedByEntryId], references: [id])
  appliedAmount    Decimal      @db.Decimal(18, 4)
  appliedDate      DateTime     @db.Date

  createdAt DateTime @default(now())

  @@index([openItemId])
  @@index([tenantId])
  @@map("ap_application")
}

// ---- Fixed Assets ------------------------------------------------------

model FixedAsset {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])

  code                  String // asset tag, e.g. "LAPTOP-001"
  description           String
  category              String? // e.g. "COMPUTER_EQUIPMENT"
  vendorPartyId         String?          @db.Uuid
  vendor                Party?           @relation("FixedAssetVendor", fields: [vendorPartyId], references: [id])
  acquisitionDate       DateTime         @db.Date
  acquisitionCost       Decimal          @db.Decimal(18, 4)
  acquisitionCurrencyId String
  acquisitionCurrency   Currency         @relation("FixedAssetAcqCcy", fields: [acquisitionCurrencyId], references: [code])
  status                FixedAssetStatus @default(IN_SERVICE)
  disposalDate          DateTime?        @db.Date
  disposalProceeds      Decimal?         @db.Decimal(18, 4)

  // Which gross-cost asset account on the GL holds the original cost.
  // (Accumulated depreciation lives on the per-book attributes row.)
  assetAccountCode String // e.g. "1500" Computer Equipment

  bookAttributes FixedAssetBookAttributes[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([entityId, status])
  @@index([tenantId])
  @@map("fixed_asset")
}

enum FixedAssetStatus {
  IN_SERVICE
  IDLE
  DISPOSED
  HELD_FOR_SALE
}

// Book-aware attributes. Same physical asset, divergent useful life /
// method / accumulated depreciation across books. This is THE pattern
// that produces book-tax differences for fixed assets.
model FixedAssetBookAttributes {
  assetId                 String             @db.Uuid
  asset                   FixedAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  bookId                  String             @db.Uuid
  book                    Book               @relation(fields: [bookId], references: [id])
  usefulLifeMonths        Int
  depreciationMethod      DepreciationMethod
  inServiceDate           DateTime           @db.Date
  salvageValue            Decimal            @default(0) @db.Decimal(18, 4)
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(18, 4)
  lastDepreciatedThrough  DateTime?          @db.Date

  // GL accounts used when the depreciation runner posts journal entries
  // for this book.
  depreciationExpenseAccountCode String // e.g. "8000" Depreciation Expense
  accumDepreciationAccountCode   String // e.g. "1510" Accum Dep contra-asset

  @@id([assetId, bookId])
  @@index([bookId, lastDepreciatedThrough])
  @@map("fixed_asset_book_attributes")
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DOUBLE_DECLINING
  MACRS_3_HY
  MACRS_5_HY
  MACRS_7_HY
  MACRS_15_HY
  UNITS_OF_PRODUCTION
  NONE // for non-depreciable assets (land)
}

// ---- Leases (ASC 842 / IFRS 16) -----------------------------------------

model Lease {
