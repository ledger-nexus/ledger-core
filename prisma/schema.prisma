// ledger-core — Universal accounting substrate (Prisma schema)
//
// This schema implements Layers 1, 2, and the empty seams for Layers 3-6 of
// the universal accounting schema documented in docs/universal-schema.md.
//
//   Layer 1 — Posting substrate: Account, JournalEntry, JournalLine.
//             Identical for every source system.
//   Layer 2 — Master data: LegalEntity, Book, FiscalCalendar, Period,
//             Currency, FxRate, Party, PartyRole, Item.
//   Layer 3 — Dimension engine: Dimension, DimensionValue, DimensionSet,
//             DimensionSetValue. Tables exist, no values seeded.
//   Layer 4 — Document layer: PostingRule table only. Document tables
//             (invoice, bill, etc.) live in consumer repos (recon, revenue-rec).
//   Layer 5 — Custom fields: `extensions Json` on every entity + a
//             CustomFieldDefinition registry. No EAV.
//   Layer 6 — Lineage: source_system / source_record_id / source_payload /
//             mapping_version on every imported row. Wired from day one.
//
// LOCKED DECISIONS (do not re-litigate; see docs/universal-schema.md):
//   - Multi-book is committed. Pattern 2 (full parallel ledgers).
//   - book_id is on JournalEntry; period close is per (entity, book, period).
//   - No fixed dimension columns on JournalLine — use the dimension engine.
//   - Customers/Vendors/Employees collapse into one Party + party_role.
//   - Surrogate keys are generated UUIDs; source-system IDs live in lineage.
//   - Three currency amounts per line: transaction, functional, reporting.
//
// Prisma model names stay accountant-friendly (Account, JournalEntry,
// JournalLine). The @@map directives align SQL table names with the
// universal-schema vocabulary so direct Postgres queries match the spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// Multi-tenancy — Tenant + Membership + per-tenant API tokens
// =========================================================================
//
// A Tenant is the firm or company using ledger-nexus. Every domain row
// (LegalEntity, Account, JournalEntry, AR/AP/FA/Lease/RevenueContract,
// audit log, etc.) carries a tenantId so cross-tenant data is invisible
// by construction.
//
// See docs/multi-tenancy.md for what's tenant-scoped vs global and the
// migration strategy. Book, Currency, FxRate, and User are global — they
// don't carry tenantId. Everything else does.
//
// Token-tenant binding: internal HTTP endpoints map an INTERNAL_API_TOKEN
// to a single TenantApiToken row, which gives them their tenantId for
// the request. Each companion repo (recon, revenue-rec, integrations,
// fa-amort) has its own per-tenant token.

model Tenant {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String @unique // url-safe, e.g. "acme-co"
  name        String
  ownerUserId String @db.Uuid

  // ─── Maker-checker policy (PR #46 harvest ④) ───────────────────────
  /// When true, non-approver journal entries land in the
  /// PENDING_APPROVAL queue instead of posting directly. Default off —
  /// solo books and small teams keep the historical behavior.
  requireJeApproval Boolean @default(false)
  /// Optional amount threshold. Null (or ≤ 0) with the flag on means
  /// EVERY non-approver entry queues; when > 0, only entries whose
  /// total ≥ this amount queue and smaller ones post directly. Units:
  /// the entry's own currency total (one currency per entry).
  jeApprovalMinAmount Decimal? @db.Decimal(18, 4)

  // ─── Ownership transfer (PR #46 harvest ⑤) ─────────────────────────
  /// Two-step OWNER hand-off: these columns record the target user +
  /// when the offer was made. The target must accept (Server Action
  /// gated on currentUser.id === pendingOwnerTransferToUserId) to swap;
  /// either side can cancel before that. The atomic swap rotates
  /// Tenant.ownerUserId + flips the OWNER/ADMIN roles on the two
  /// memberships in one $transaction. Null on both = no transfer
  /// pending. Initiator-only column kept thin — the initiator is always
  /// the current OWNER, recoverable from ownerUserId while non-null.
  pendingOwnerTransferToUserId    String?   @db.Uuid
  pendingOwnerTransferInitiatedAt DateTime?

  memberships TenantMembership[]
  apiTokens   TenantApiToken[]

  // Backrefs from tenant-scoped domain models. Listed here so Prisma can
  // resolve the relations on the other side. Cascading delete is OFF by
  // default — soft delete is the intended path for tenant offboarding
  // (see docs/multi-tenancy.md "Open questions").
  legalEntities             LegalEntity[]
  fiscalCalendars           FiscalCalendar[]
  periods                   Period[]
  periodCloses              PeriodClose[]
  balanceAssertions         BalanceAssertion[]
  commodities               Commodity[]
  commodityPrices           CommodityPrice[]
  lots                      Lot[]
  parties                   Party[]
  partyRoles                PartyRole[]
  items                     Item[]
  accounts                  Account[]
  journalEntries            JournalEntry[]
  journalLines              JournalLine[]
  dimensions                Dimension[]
  dimensionValues           DimensionValue[]
  dimensionSets             DimensionSet[]
  postingRules              PostingRule[]
  customFieldDefinitions    CustomFieldDefinition[]
  arOpenItems               ArOpenItem[]
  arApplications            ArApplication[]
  apOpenItems               ApOpenItem[]
  apApplications            ApApplication[]
  fixedAssets               FixedAsset[]
  leases                    Lease[]
  revenueContracts          RevenueContract[]
  queues                    Queue[]
  recordEvents              RecordEvent[]
  auditLogs                 AuditLog[]
  reassignmentRules         ReassignmentRule[]
  notifications             Notification[]
  recurringEntries          RecurringEntry[]
  journalEntryNotes         JournalEntryNote[]
  // BlackLine arc Phase 1: account-reconciliation workflow.
  reconciliations           Reconciliation[]
  reconciliationAttachments ReconciliationAttachment[]
  reconciliationConfig      ReconciliationConfig?
  // BlackLine arc Phase 2: close-task calendar.
  closeTasks                CloseTask[]
  closeTaskTemplates        CloseTaskTemplate[]
  closeTaskComments         CloseTaskComment[]
  closeTaskStateChanges     CloseTaskStateChange[]
  // BlackLine arc Phase 3: flux / variance analysis.
  fluxStatements            FluxStatement[]
  fluxLines                 FluxLine[]
  // Notifications arc: per-tenant Slack/etc channels for close alerts.
  notificationChannels      NotificationChannel[]
  notificationDispatches    NotificationDispatch[]
  bankTransactions          BankTransaction[]
  emailDeliveries           EmailDelivery[]
  invites                   TenantInvite[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime? // soft delete
  BankRule  BankRule[]

  @@index([ownerUserId])
  @@map("tenant")
}

model TenantMembership {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String     @db.Uuid
  userId   String     @db.Uuid
  role     TenantRole @default(MEMBER)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_membership")
}

enum TenantRole {
  OWNER // cannot be removed; can delete the tenant
  ADMIN // full read+write+admin (period close, user lifecycle)
  MEMBER // read+write, no admin actions
  VIEWER // read-only — reports and pages, no mutations (auditors)
}

// Per-tenant API tokens for companion-repo authentication.
//
// Each repo (recon, revenue-rec, integrations, fa-amort) holds its
// tenant's token in its Vercel env. ledger-core hashes incoming
// Authorization Bearer values and looks them up here to resolve the
// tenantId for the request. lastUsedAt is updated on every successful
// auth; revokedAt cuts off the token.
//
// label is a short human-readable identifier so the audit log shows
// "recon-prod" instead of an opaque token ID.
model TenantApiToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique // sha256 of the plaintext token
  label      String // e.g. "recon-prod", "fa-amort-staging"
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([tenantId])
  @@map("tenant_api_token")
}

// =========================================================================
// Layer 2 — Master Data
// =========================================================================

model LegalEntity {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // tenantId is nullable during migration (Phase 1); Phase 4 backfills
  // remaining rows, scopes all queries, and applies NOT NULL.
  tenantId       String        @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Phase 4b: code is unique PER tenant. Two tenants can both own
  // an entity coded "ACME" — collisions are isolated by tenantId.
  code           String
  name           String
  parentEntityId String?       @db.Uuid
  parent         LegalEntity?  @relation("EntityHierarchy", fields: [parentEntityId], references: [id])
  children       LegalEntity[] @relation("EntityHierarchy")

  // The currency this entity reports in. Each book may override for reporting.
  functionalCurrencyId String
  functionalCurrency   Currency @relation("EntityFunctionalCcy", fields: [functionalCurrencyId], references: [code])

  // v0.9 NS Books — promoted from `extensions.nsIsElimination` JSON flag
  // to a real column. NetSuite OneWorld designates one subsidiary per
  // group as the "elimination subsidiary" — its only postings are the
  // intercompany eliminations the consolidation engine generates. The
  // existing IC-subtype elimination logic (DUE_FROM/DUE_TO/INTERCOMPANY_*)
  // is account-driven and doesn't need this flag yet, but the column
  // unblocks future entity-level elimination behavior (e.g. "post the
  // CTA plug to the elimination sub instead of the parent").
  isEliminationEntity Boolean @default(false)

  // Lineage — null for natively-created entities; populated on ERP import.
  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  fiscalCalendars  FiscalCalendar[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  parties          Party[]
  items            Item[]
  periodCloses     PeriodClose[]
  balanceAssertions BalanceAssertion[]
  lots              Lot[]
  fixedAssets      FixedAsset[]
  leases           Lease[]
  revenueContracts RevenueContract[]
  arOpenItems      ArOpenItem[]
  apOpenItems      ApOpenItem[]
  recurringEntries RecurringEntry[]
  reconciliations  Reconciliation[]
  // BlackLine arc Phase 2: close-task calendar.
  closeTasks       CloseTask[]
  bankTransactions BankTransaction[]
  // BlackLine arc Phase 3: flux / variance analysis.
  fluxStatements   FluxStatement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("legal_entity")
}

model Book {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String    @unique // e.g. "US_GAAP", "US_TAX", "IFRS", "MGMT"
  name                String
  // The accounting basis. Drives default behavior in posting rules + reports.
  basis               BookBasis
  // Reporting currency for THIS book. Functional currency lives on LegalEntity.
  // Permits e.g. a US entity with a USD functional ledger but an EUR-reported IFRS book.
  reportingCurrencyId String
  reportingCurrency   Currency  @relation("BookReportingCcy", fields: [reportingCurrencyId], references: [code])

  isActive   Boolean @default(true)
  extensions Json?

  journalEntries                JournalEntry[]
  periodCloses                  PeriodClose[]
  balanceAssertions             BalanceAssertion[]
  lots                          Lot[]
  postingRules                  PostingRule[]
  fixedAssetBookAttributes      FixedAssetBookAttributes[]
  leaseBookAttributes           LeaseBookAttributes[]
  revenueContractBookAttributes RevenueContractBookAttributes[]
  arOpenItems                   ArOpenItem[]
  apOpenItems                   ApOpenItem[]
  recurringEntries              RecurringEntry[]
  reconciliations               Reconciliation[]
  // BlackLine arc Phase 2: close-task calendar.
  closeTasks                    CloseTask[]
  bankTransactions              BankTransaction[]
  // BlackLine arc Phase 3: flux / variance analysis.
  fluxStatements                FluxStatement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("book")
}

enum BookBasis {
  US_GAAP
  US_TAX
  IFRS
  MGMT
  STATUTORY
}

model FiscalCalendar {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId        String          @db.Uuid
  entity          LegalEntity     @relation(fields: [entityId], references: [id])
  code            String // e.g. "STANDARD_2026"
  name            String
  periodFrequency PeriodFrequency @default(MONTHLY)

  periods Period[]

  createdAt DateTime @default(now())

  @@unique([entityId, code])
  @@index([tenantId])
  @@map("fiscal_calendar")
}

enum PeriodFrequency {
  MONTHLY
  QUARTERLY
  WEEKLY_4_4_5
  WEEKLY_4_5_4
  WEEKLY_5_4_4
  CUSTOM
}

model Period {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String         @db.Uuid
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  calendarId String         @db.Uuid
  calendar   FiscalCalendar @relation(fields: [calendarId], references: [id])
  code       String // e.g. "2026-01", "2026-Q1"
  ordinal    Int // 1..12 for monthly, 1..52 for weekly
  startsOn   DateTime       @db.Date
  endsOn     DateTime       @db.Date

  journalEntries     JournalEntry[]
  closes             PeriodClose[]
  reconciliations    Reconciliation[]
  // BlackLine arc Phase 2: close-task calendar.
  closeTasks         CloseTask[]
  // BlackLine arc Phase 3: flux / variance analysis.
  fluxStatementsFrom FluxStatement[]  @relation("FluxFromPeriod")
  fluxStatementsTo   FluxStatement[]  @relation("FluxToPeriod")

  @@unique([calendarId, code])
  @@unique([calendarId, ordinal])
  @@index([startsOn, endsOn])
  @@index([tenantId])
  @@map("period")
}

// Close locks are per (entity, book, period) — GAAP April can be closed while
// Tax April stays open. The posting function refuses writes against closed
// (entity, book, period) tuples.
model PeriodClose {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])
  periodId String      @db.Uuid
  period   Period      @relation(fields: [periodId], references: [id])
  closedAt DateTime    @default(now())
  closedBy String?

  @@unique([entityId, bookId, periodId])
  @@index([tenantId])
  @@map("period_close")
}

// Append-only reopen history. PeriodClose is binary — a row exists (closed) or
// it doesn't (open) — so deleting it on reopen erases the fact that a period was
// ever reopened, and why. This log preserves each reopen as an immutable fact:
// who, when, and the REQUIRED reason. Tamper-evident capture also lives in
// audit_log (DB-RULE append-only); this table is the queryable domain
// projection ("show every reopen of 2026-05 with reasons"). Columns are
// denormalized (codes + reopenedBy email, no FK relations) so a row survives
// deletion of its period/entity — the same survival rationale as
// audit_log.actorEmail. Insert-only by application convention.
model PeriodReopenLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  entityId   String   @db.Uuid
  bookId     String   @db.Uuid
  entityCode String
  bookCode   String
  periodCode String
  reason     String
  reopenedBy String? // admin email; denormalized for trail survival
  reopenedAt DateTime @default(now())

  @@index([tenantId])
  @@index([entityId, bookId, periodCode])
  @@map("period_reopen_log")
}

// Balance assertion — "this account held exactly this much on this date."
//
// postJournalEntry enforces correctness at the moment of WRITE (debits =
// credits, account validity, period close). An assertion enforces correctness
// ACROSS TIME: it catches silent drift — a double-posted import, a missed
// reversal, a mapper regression — on the date it first appears, instead of at
// period close. Cheap and machine-checked, so it can run continuously (e.g.
// after every bank-feed import).
//
// This does NOT duplicate Reconciliation. Reconciliation is the periodic,
// human, attested control (glBalance vs supportingBalance + sign-off); an
// assertion is a continuous tripwire. They are complementary — keep both.
//
// asOf semantics: END of day — the observed balance includes every entry with
// documentDate <= asOf, matching getTrialBalance. (Beancount, the source of
// this idea, asserts at the START of the date. The divergence is deliberate;
// mixing the two silently answers the wrong question.)
//
// expectedAmount is stated on the account's NORMAL side, matching
// TrialBalanceRow.balance. tolerance null => derived from Currency.decimals
// (one unit of the last decimal place: 0.01 USD, 1 JPY).
model BalanceAssertion {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])
  accountId String     @db.Uuid
  account   Account    @relation(fields: [accountId], references: [id])

  // v1 asserts in the book's reporting currency. Plain column (no relation),
  // matching ar_open_item / ap_open_item. Carried explicitly so per-commodity
  // assertions remain expressible once a commodity/price layer exists.
  currencyId String

  asOf           DateTime @db.Date
  expectedAmount Decimal  @db.Decimal(20, 4)
  tolerance      Decimal? @db.Decimal(20, 4)

  // Result cache. The assertion itself is the durable fact; these are a
  // recomputable snapshot of the last check so a UI can render without
  // re-running the whole sweep.
  lastCheckedAt      DateTime?
  lastObservedAmount Decimal?        @db.Decimal(20, 4)
  lastStatus         AssertionStatus @default(UNCHECKED)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, bookId, accountId, currencyId, asOf])
  @@index([tenantId])
  @@index([entityId, bookId, asOf])
  @@map("balance_assertion")
}

enum AssertionStatus {
  UNCHECKED
  PASS
  FAIL
}

model Currency {
  // ISO 4217 code is the primary key — these are stable.
  code     String  @id // "USD", "EUR", "JPY"
  name     String
  decimals Int     @default(2) // 2 for USD, 0 for JPY, etc.
  symbol   String?

  fxRatesFrom        FxRate[]          @relation("FxFrom")
  fxRatesTo          FxRate[]          @relation("FxTo")
  entitiesFunctional LegalEntity[]     @relation("EntityFunctionalCcy")
  booksReporting     Book[]            @relation("BookReportingCcy")
  journalEntries     JournalEntry[]    @relation("JeCurrency")
  linesTxn           JournalLine[]     @relation("LineTxnCcy")
  linesReporting     JournalLine[]     @relation("LineReportingCcy")
  fixedAssets        FixedAsset[]      @relation("FixedAssetAcqCcy")
  leases             Lease[]           @relation("LeaseCcy")
  revenueContracts   RevenueContract[] @relation("RevContractCcy")
  recurringEntries   RecurringEntry[]

  @@map("currency")
}

model FxRate {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromCurrencyId String
  toCurrencyId   String
  fromCurrency   Currency   @relation("FxFrom", fields: [fromCurrencyId], references: [code])
  toCurrency     Currency   @relation("FxTo", fields: [toCurrencyId], references: [code])
  asOf           DateTime   @db.Date
  rate           Decimal    @db.Decimal(20, 10)
  rateType       FxRateType @default(SPOT)

  @@unique([fromCurrencyId, toCurrencyId, asOf, rateType])
  @@index([asOf])
  @@map("fx_rate")
}

// Commodity — a tradeable instrument that is NOT a currency: a stock, ETF,
// fund, crypto asset, etc. Currency is ISO-4217-keyed and global ("these are
// stable"); a commodity is tenant master data like Item / Party, so it carries
// tenantId and is unique per (tenant, symbol). Keeping the two apart is
// deliberate — a security price is unrepresentable in FxRate (which is
// currency->currency), and pushing securities into Currency would pollute
// Layer-2 master data. See docs/spec/beancount-adoption-study.md (item 3).
//
// This is an ADDITIVE Layer-2 extension: nothing here changes Currency, FxRate
// or the posting path. It establishes the seam that mark-to-market / holdings
// valuation and per-commodity balance assertions can build on later.
model Commodity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Beancount-style symbol: "AAPL", "BTC", "VTSAX". Not an ISO currency.
  symbol     String
  name       String
  // Free-form for v1 ("EQUITY", "CRYPTO", "FUND", ...). A typed enum can come
  // later once the set stabilises.
  assetClass String?
  active     Boolean  @default(true)

  prices CommodityPrice[]
  lots   Lot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, symbol])
  @@index([tenantId])
  @@map("commodity")
}

// A price point: the value of ONE unit of a commodity, quoted in a currency,
// on a date. Mirrors FxRate (the currency-pair price DB) but for commodities.
// Resolution is on-or-before (see getCommodityPrice), the same convention as
// resolveFxRate. Last write for a given (commodity, currency, date) wins —
// matching Beancount's "the last price declaration on a day is retained".
//
// currencyId is a plain code column (no relation) to avoid a Currency backref,
// matching ar_open_item.currencyId.
model CommodityPrice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  commodityId String    @db.Uuid
  commodity   Commodity @relation(fields: [commodityId], references: [id], onDelete: Cascade)
  currencyId  String
  asOf        DateTime  @db.Date
  price       Decimal   @db.Decimal(20, 10)
  // Provenance: "MANUAL", "IMPORT:<system>", etc. Optional.
  source      String?

  createdAt DateTime @default(now())

  @@unique([commodityId, currencyId, asOf])
  @@index([tenantId])
  @@index([commodityId, currencyId, asOf])
  @@map("commodity_price")
}

// Lot — a parcel of a commodity acquired at a specific per-unit cost on a
// specific date, held in an account, per book. This is the persistence layer
// under the pure inventory engine (src/lib/accounting/inventory.ts): a purchase
// AUGMENTS (creates) a lot; a sale REDUCES lots, drawing `remainingUnits` down
// by booking method until the parcel is exhausted (status → CLOSED). Cost basis
// is preserved parcel by parcel, which is what makes per-lot capital gains
// possible.
//
// Book-aware, following the canon's "inventory layers" master-data-extension
// pattern (like fixed_asset_book_attributes): the same holding can carry a
// different basis under US_GAAP vs US_TAX. Modeled on ArOpenItem — a per-(entity,
// book) sub-ledger parcel opened by a JournalEntry. openedByEntryId is nullable
// so a lot can be seeded / imported before its GL posting is wired (the posting
// integration is a later part of the arc).
model Lot {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])

  // The account the commodity is held in (the investment / asset account).
  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  commodityId String    @db.Uuid
  commodity   Commodity @relation(fields: [commodityId], references: [id])

  // The JournalEntry that opened this lot (the purchase). Nullable — a lot may
  // be seeded / imported before its GL posting exists.
  openedByEntryId String?       @db.Uuid
  openedByEntry   JournalEntry? @relation(fields: [openedByEntryId], references: [id])

  label           String?  // optional user label ("RSU tranche 3", broker lot id)
  acquisitionDate DateTime @db.Date

  // Units + per-unit cost. High precision for fractional shares / crypto.
  // costCurrencyId is a plain code (no relation), matching ar_open_item.
  originalUnits  Decimal @db.Decimal(28, 10)
  remainingUnits Decimal @db.Decimal(28, 10)
  unitCost       Decimal @db.Decimal(28, 10)
  costCurrencyId String

  status LotStatus @default(OPEN)

  // Lineage — populated on import; also the natural idempotency key for the
  // augment-on-purchase path once posting is wired.
  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([entityId, bookId, accountId, commodityId, status])
  @@index([entityId, bookId, commodityId, status, acquisitionDate])
  @@map("lot")
}

enum LotStatus {
  OPEN
  CLOSED
}

enum FxRateType {
  SPOT
  AVG // period-average rate (used for revenue/expense translation)
  CLOSE // period-close rate (used for balance-sheet translation)
  HISTORICAL // rate at a specific point (used for equity translation)
}

model Party {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String       @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId    String?      @db.Uuid // null = shared across entities
  entity      LegalEntity? @relation(fields: [entityId], references: [id])
  code        String // human-readable, often source-system code
  displayName String

  // Customer:Job / Project / WBS / Sage Job all collapse to one Party with parent.
  // Per spec anti-pattern list: do NOT model jobs as a kind of customer.
  parentPartyId String? @db.Uuid
  parent        Party?  @relation("PartyHierarchy", fields: [parentPartyId], references: [id])
  children      Party[] @relation("PartyHierarchy")

  roles             PartyRole[]
  journalLines      JournalLine[]
  vendorFixedAssets FixedAsset[]      @relation("FixedAssetVendor")
  lessorLeases      Lease[]           @relation("LeaseLessor")
  customerContracts RevenueContract[] @relation("ContractCustomer")
  arOpenItems       ArOpenItem[]
  apOpenItems       ApOpenItem[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([tenantId])
  @@map("party")
}

model PartyRole {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String        @db.Uuid
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  partyId  String        @db.Uuid
  party    Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  role     PartyRoleKind
  startsOn DateTime?     @db.Date
  endsOn   DateTime?     @db.Date

  @@unique([partyId, role])
  @@index([tenantId])
  @@map("party_role")
