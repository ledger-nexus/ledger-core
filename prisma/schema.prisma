enum PartyRoleKind {
  CUSTOMER
  VENDOR
  EMPLOYEE
  OTHER
}

model Item {
  id                          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                    String         @db.Uuid
  tenant                      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId                    String?        @db.Uuid
  entity                      LegalEntity?   @relation(fields: [entityId], references: [id])
  code                        String
  name                        String
  itemType                    ItemType       @default(SERVICE)
  costingMethod               CostingMethod?
  defaultIncomeAccountCode    String?
  defaultExpenseAccountCode   String?
  defaultInventoryAccountCode String?

  journalLines JournalLine[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([tenantId])
  @@map("item")
}

enum ItemType {
  INVENTORY
  NON_INVENTORY
  SERVICE
  KIT
  ASSEMBLY
  FIXED_ASSET
}

enum CostingMethod {
  FIFO
  LIFO
  AVERAGE
  STANDARD
  SPECIFIC
}

// =========================================================================
// Layer 1 — Posting Substrate
// =========================================================================

model Account {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // entityId null = shared across all entities (consolidated chart).
  // Set to a value = entity-specific account.
  entityId String?      @db.Uuid
  entity   LegalEntity? @relation(fields: [entityId], references: [id])

  // Human-readable code (e.g. "1000" for Cash). NOT a source-system primary key.
  // Convention: 1xxx Assets, 2xxx Liabilities, 3xxx Equity, 4xxx Revenue, 5xxx-9xxx Expenses.
  code             String
  name             String
  type             AccountType
  normalBalance    NormalBalance
  subtype          String? // e.g. "CASH", "AR_TRADE", "INVENTORY_RAW"
  isContra         Boolean       @default(false)
  isControlAccount Boolean       @default(false) // true for AR/AP control accounts
  isBank           Boolean       @default(false)

  // ASC 830 / IAS 21: monetary accounts (cash, receivables, payables, debt)
  // hold a fixed number of currency units, so a foreign-currency balance is
  // re-measured to the functional currency at the period-end CLOSE rate and
  // the delta hits FX gain/loss. Non-monetary accounts (inventory, fixed
  // assets, prepaids, equity) stay at historical rate and are NOT revalued.
  // The revaluation engine walks accounts where isMonetary = true.
  isMonetary Boolean @default(false)

  // FX Phase 4 — ASC 830 translation method for CONSOLIDATION (distinct
  // from isMonetary, which drives period-end remeasurement). Nullable so
  // existing single-currency installations don't need a backfill; the
  // consolidation translator defaults to CURRENT_RATE when null. New
  // chart-of-accounts rows + seed paths set this explicitly per category.
  translationCategory TranslationCategory?

  parentAccountId String?   @db.Uuid
  parent          Account?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children        Account[] @relation("AccountHierarchy")

  // Books this account applies to. Empty = applies to all books.
  // e.g. ["US_TAX"] for a tax-only account; empty for a normal account.
  bookScope String[] @default([])

  active Boolean @default(true)

  // Commodities this account may hold. EMPTY = unconstrained (the default, so
  // this is inert for every existing account). When set, postJournalEntry
  // refuses an entry whose currency isn't listed — a USD-only cash account
  // cannot silently accumulate EUR. Same "make invalid states unrepresentable"
  // intent as the debit/credit CHECK constraints, one level up.
  allowedCurrencies String[] @default([])

  // Dated account lifecycle. `active` is a boolean and therefore cannot answer
  // "was this account valid on the ENTRY's date" — which is the only question
  // that matters for a backdated post. These can, and postJournalEntry checks
  // them against documentDate.
  //
  // BOUNDARIES ARE INCLUSIVE: the account is postable on [openedOn, closedOn].
  // A post ON the open date or ON the close date is allowed; before or after is
  // refused. NULL on either side means unbounded, so both are inert by default.
  openedOn DateTime? @db.Date
  closedOn DateTime? @db.Date

  // BlackLine arc Phase 1: per-account override of the tenant default.
  // - requiresReconReview: null = inherit ReconciliationConfig.defaultRequiresReview.
  //   true = always preparer→reviewer chain. false = single sign-off OK.
  // - reconTolerance: null = inherit tenant default (typically 0 = must tie out
  //   exactly). Non-null = $-amount diff allowed before marking EXCEPTION.
  //   Used by cash accounts where rounding differences are common.
  requiresReconReview Boolean?
  reconTolerance      Decimal? @db.Decimal(20, 4)

  lines                   JournalLine[]
  reconciliations         Reconciliation[]
  balanceAssertions       BalanceAssertion[]
  lots                    Lot[]
  bankFeedTransactions    BankTransaction[] @relation("BankTxnBankAccount")
  categorizedTransactions BankTransaction[] @relation("BankTxnCategory")
  bankRuleCategories      BankRule[]        @relation("BankRuleCategory")
  bankRuleAccounts        BankRule[]        @relation("BankRuleBankAccount")
  // BlackLine arc Phase 3: flux / variance analysis.
  fluxLines               FluxLine[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([type])
  @@index([tenantId])
  @@map("account")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

// v0.8 FX Phase 4 — ASC 830 period-end translation method per account.
//
// When consolidating a foreign-functional-currency subsidiary into a
// parent's reporting currency, each account's balance is translated
// at a rate chosen per its category:
//
//   CURRENT_RATE  — Balance Sheet items (assets, liabilities). The
//                   period-end ("current") rate. Default for asset +
//                   liability account types.
//
//   HISTORICAL    — Equity items, recorded at the rate when each
//                   contribution / dividend was originally posted.
//                   Default for equity account types. The translator
//                   uses the original transaction-date rate.
//
//   WEIGHTED_AVG  — Income Statement items (revenue, expense). The
//                   period-average rate. Default for revenue + expense
//                   account types.
//
//   EXCLUDED      — Accounts that are themselves the translation
//                   result and must NOT be re-translated (e.g. 8300
//                   Realized FX Gain/Loss is already in reporting
//                   currency at posting time). Treated as already-
//                   translated, no rate applied.
//
// Phase 4a (this commit) only adds the column + defaults. Phase 4b
// adds the translator. Phase 4c wires it into the consolidation report.
enum TranslationCategory {
  CURRENT_RATE
  HISTORICAL
  WEIGHTED_AVG
  EXCLUDED
}

// One row per posted document. Posts to exactly ONE (entity, book).
// Multi-book postings of a single source event create N JournalEntry rows
// (one per book), all sharing the same source_record_id in lineage.
model JournalEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // entryNumber is a human-readable sequential ID, unique per (entity, book).
  // Format: ENTITY-BOOK-NNNNN (e.g. NORTHWIND-US_GAAP-00001).
  // Phase 4b: unique per [tenantId, entryNumber] — each tenant can have
  // its own NORTHWIND-US_GAAP-00001 without colliding.
  entryNumber String

  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])

  // periodId is resolved at posting time from the document/posting date and
  // the entity's fiscal calendar. Null only allowed for entries dated before
  // any defined period (historical pre-go-live data).
  periodId String? @db.Uuid
  period   Period? @relation(fields: [periodId], references: [id])

  // Document date = when the transaction is dated (invoice date).
  // Posting date = when it hit the ledger (often same; can differ for backdated entries).
  documentDate DateTime @db.Date
  postingDate  DateTime @db.Date

  memo String

  // Header currency = the transaction's natural currency. fxRate translates
  // it to the book's reporting currency. Per-line currency is allowed in
  // edge cases (intercompany) but defaults to the header.
  currencyId String
  currency   Currency @relation("JeCurrency", fields: [currencyId], references: [code])
  fxRate     Decimal  @default(1) @db.Decimal(20, 10)

  source JournalSource @default(MANUAL)
  status EntryStatus   @default(POSTED)

  // ─── Maker-checker approval columns (PR #46 harvest ④) ─────────────
  // Populated only for entries that flow through the approval queue;
  // direct ADMIN+ postings leave all of these null. submittedById is
  // the maker; approved*/rejected* are set when an approver resolves
  // it. rejectionReason is required when a pending entry flips to VOID
  // (withdraw reuses the rejected* columns with a "Withdrawn:" prefix
  // and rejectedById === submittedById as the marker). Bare UUIDs, not
  // relations — same posture as ownerId's polymorphic discipline.
  submittedById   String?   @db.Uuid
  submittedAt     DateTime?
  approvedById    String?   @db.Uuid
  approvedAt      DateTime?
  rejectedById    String?   @db.Uuid
  rejectedAt      DateTime?
  rejectionReason String?

  reversalOfId String?        @db.Uuid
  reversalOf   JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry[] @relation("Reversal")

  // Correction lineage — a supplemental reclassification / correcting entry
  // that fixes the classification of an earlier POSTED entry WITHOUT negating
  // it. Unlike a reversal (which flips the source to REVERSED), the source of
  // a correction stays POSTED: the correction is an additional adjusting entry,
  // and this link records "this entry corrects that one" so the audit trail and
  // the balance-change lineage view can follow it. Mirrors reversalOf.
  correctionOfId String?        @db.Uuid
  correctionOf   JournalEntry?  @relation("Correction", fields: [correctionOfId], references: [id])
  corrections    JournalEntry[] @relation("Correction")

  // Lineage — non-negotiable per spec. Populated on every ERP import.
  sourceSystem     String? // "QBO", "NETSUITE", "INTACCT", ...
  sourceRecordType String? // "Invoice", "Bill", "JournalEntry", ...
  sourceRecordId   String? // the source system's ID (NEVER reused as our PK)
  sourcePayload    Json? // frozen raw original
  mappingVersion   String?
  extensions       Json?

  // Denormalized line sums. Per the invariant that debits == credits,
  // these are equal on every well-formed entry (postJournalEntry
  // enforces this). Stored to make amount-based filtering on the
  // saved-search endpoint (NS SuiteAnalytics Phase 4 follow-up) and
  // future reporting queries an O(1) index lookup instead of a JOIN
  // + aggregate. Backfilled by migration 0012; populated on every
  // new entry by postJournalEntry.
  totalDebit  Decimal @default(0) @db.Decimal(18, 4)
  totalCredit Decimal @default(0) @db.Decimal(18, 4)

  lines JournalLine[]

  // Sub-ledger backrefs — entries that opened or applied to sub-ledger items.
  arOpenItemsOpened ArOpenItem[]    @relation("ArOpenedBy")
  apOpenItemsOpened ApOpenItem[]    @relation("ApOpenedBy")
  arApplications    ArApplication[] @relation("ArAppliedBy")
  apApplications    ApApplication[] @relation("ApAppliedBy")
  openedLots        Lot[]

  // Ownership + audit. ownerId is the default-responsible-party; defaults to
  // createdBy at insert and only changes via explicit reassignment (manual or
  // rule-fired). In ERP modules, ownerId is informational/workflow — module
  // permissions handle access control, NOT this field. See
  // docs/ownership-and-rules.md for the full semantic.
  ownerId              String?   @db.Uuid
  ownerType            OwnerType @default(USER)
  updatedBy            String?
  updatedAt            DateTime  @default(now()) @updatedAt
  // When set, the reassignment-rules engine SKIPS this record. Cleared
  // explicitly by an admin or by a state transition; never auto-cleared.
  reassignmentLockedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?

  // Backref to ownership events.
  recordEvents RecordEvent[] @relation("JournalEntryEvents")

  // Backref to inline notes (review comments, follow-up flags).
  notes            JournalEntryNote[]
  // 1:1 — a posted entry is claimed by at most one bank-feed line. The
  // uniqueness is enforced on BankTransaction.postedEntryId so two feed
  // lines can't match/categorize onto the same entry (TOCTOU guard).
  bankTransaction  BankTransaction?

  @@unique([tenantId, entryNumber])
  @@index([ownerId])
  @@index([entityId, bookId, documentDate])
  @@index([entityId, bookId, periodId])
  @@index([sourceSystem, sourceRecordType, sourceRecordId])
  @@index([tenantId, postingDate])
  // Pending-approval queue: list PENDING_APPROVAL for a tenant, newest first.
  @@index([tenantId, status, createdAt])
  @@map("gl_entry_header")
}

enum JournalSource {
  MANUAL // entered by a human via the UI
  SEED // loaded from seed data
  SYSTEM // posted by another module (e.g. rev rec engine)
  AI_APPROVED // AI suggested, human approved (used in recon project)
  IMPORT // ERP import (companion to source_system lineage)
}

enum EntryStatus {
  DRAFT
  PENDING_APPROVAL // maker-checker queue: lines exist + balance, NO ledger effect until approved
  POSTED
  VOID // rejected/withdrawn pending entries land here too (rejectionReason set)
  REVERSED
}

model JournalLine {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // tenantId denormalized from the parent JournalEntry for query speed.
  // Always equals entry.tenantId; enforced in postJournalEntry.
  tenantId  String       @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entryId   String       @db.Uuid
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  lineNo    Int // 1-based, position within entry
  accountId String       @db.Uuid
  account   Account      @relation(fields: [accountId], references: [id])

  // Sub-ledger keys — nullable. When populated, the entry contributes to a
  // sub-ledger lifecycle (e.g. partyId set on an AR line opens/applies an
  // AR open item). The open-item tables themselves arrive in the next batch.
  partyId String? @db.Uuid
  party   Party?  @relation(fields: [partyId], references: [id])
  itemId  String? @db.Uuid
  item    Item?   @relation(fields: [itemId], references: [id])

  // Layer 3 — dimension engine. Nullable until the first ERP import that
  // carries class/department/location dimensions.
  dimensionSetId String?       @db.Uuid
  dimensionSet   DimensionSet? @relation(fields: [dimensionSetId], references: [id])

  // taxCodeId — slot. TaxCode table arrives with the document layer in a
  // consumer repo. String form here to avoid a meaningless empty table now.
  taxCodeId String?

  // The canonical debit/credit pair in the BOOK's reporting currency.
  // XOR constraint enforced at the DB layer (migration SQL).
  debit  Decimal @default(0) @db.Decimal(18, 4)
  credit Decimal @default(0) @db.Decimal(18, 4)

  // Transaction-currency view (signed: debit positive, credit negative).
  // = (debit - credit) for single-currency. Diverges when the line is in
  // a non-functional currency (intercompany, FX gains/losses).
  transactionAmount     Decimal   @default(0) @db.Decimal(18, 4)
  transactionCurrencyId String?
  transactionCurrency   Currency? @relation("LineTxnCcy", fields: [transactionCurrencyId], references: [code])

  // Reporting-currency view (signed). Equals functional when the book's
  // reporting currency = the entity's functional currency.
  reportingAmount     Decimal   @default(0) @db.Decimal(18, 4)
  reportingCurrencyId String?
  reportingCurrency   Currency? @relation("LineReportingCcy", fields: [reportingCurrencyId], references: [code])

  description String?
  extensions  Json?

  @@unique([entryId, lineNo])
  @@index([entryId])
  @@index([accountId])
  @@index([partyId])
  @@index([tenantId])
  @@map("gl_entry_line")
}

// =========================================================================
// Journal entry notes (inline review comments)
// =========================================================================
// A lightweight comment thread on a JE. Real workflow: one CPA reviews the
// month, flags "verify this accrual" on an entry; another CPA sees the
// note on their next pass and either fixes the entry, posts an adjustment,
// or resolves the note.
//
// Notes do NOT change the entry's lines. They're metadata for human review.
// Resolving a note is a soft state — the note stays visible (audit) but
// renders de-emphasized. Deleting is admin-only.

model JournalEntryNote {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String       @db.Uuid
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entryId  String       @db.Uuid
  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  // Author: links to User but kept nullable for the case where a user
  // is later deactivated. authorEmail is snapshotted at write time so
  // the note's authorship survives even if the user row goes away.
  authorUserId String? @db.Uuid
  author       User?   @relation(fields: [authorUserId], references: [id])
  authorEmail  String?

  // Plain-text body for v1. No markdown / no rich text — keeps the audit
  // surface clean. CPAs write short prose.
  body String

  // Resolution: anyone in the tenant can resolve. The note stays in the
  // DB; the UI renders resolved notes muted.
  resolvedAt DateTime?
  resolvedBy String? // email snapshot (same rationale as authorEmail)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryId])
  @@index([tenantId])
  @@index([resolvedAt])
  @@map("journal_entry_note")
}

// =========================================================================
// Recurring journal entries
// =========================================================================
// Templates for predictable, schedule-driven entries (monthly rent, SaaS
// subscriptions, accruals). Each template carries a fixed shape (lines)
// plus a cadence. A nightly / on-demand `runRecurringEntries` pass walks
// active templates, computes which periods haven't yet been posted, and
// fires postJournalEntry for each — with a stable lineage triple so
// re-running is idempotent.
//
// The template is NOT a journal entry. It produces journal entries.
// Editing or deleting a template does NOT touch entries already posted;
// they're real history. Deactivating a template stops it from producing
// new entries.

model RecurringEntry {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])

  // Human-readable identifier per tenant. "MONTHLY_RENT", "QUARTERLY_AUDIT_ACCRUAL".
  code String
  memo String

  // Header currency for the produced entries. Lines are signed-quantity;
  // the JE picks up fxRate from the rate table at posting time.
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [code])

  cadence Cadence

  // First posting date. The first JE produced is dated startDate.
  // For monthly cadence, subsequent JEs are at startDate + N months
  // (anchored to startDate's day-of-month; falls back to last day of
  // month if the target month is shorter).
  startDate      DateTime  @db.Date
  // Optional sunset: no posts after endDate (inclusive). Null = forever.
  endDate        DateTime? @db.Date
  // Bookmark: the most recent docDate this template successfully posted.
  // Drives "what's next" — next posting is the cadence step AFTER this.
  // Null = never posted; the first post will use startDate.
  lastPostedDate DateTime? @db.Date

  // When false, the runner skips this template (kept for history / re-enable).
  isActive Boolean @default(true)

  lines RecurringEntryLine[]

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([entityId, bookId])
  @@map("recurring_entry")
}

model RecurringEntryLine {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String         @db.Uuid
  template   RecurringEntry @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // 1-indexed within the template.
  lineNo Int

  // Account code resolved at post time against the entity's chart.
  accountCode String

  // Money. Mirrors the substrate convention (debit XOR credit > 0).
  debit  Decimal @default(0) @db.Decimal(18, 4)
  credit Decimal @default(0) @db.Decimal(18, 4)

  description String?
  partyCode   String?
  itemCode    String?

  @@unique([templateId, lineNo])
  @@map("recurring_entry_line")
}

enum Cadence {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

// =========================================================================
// Layer 3 — Dimension Engine
// =========================================================================
// Tables defined; no values seeded in v1. Adding a value here is free —
// no schema change. This is why fixed dimension columns on JournalLine are
// an anti-pattern.

model Dimension {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String  @db.Uuid
  tenant                Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Phase 4b: unique per tenant so each tenant defines their own CLASS.
  code                  String // "DEPARTMENT", "CLASS", "LOCATION", "PROJECT"
  name                  String
  // Optional free-form descriptive blurb. Preserved across mapper
  // roundtrips so NS custom-segment definitions survive export/import.
  // Not consumed by the GL engine.
  description           String?
  isRequired            Boolean @default(false)
  // JSON array of AccountType strings this dimension applies to.
  // e.g. ["REVENUE", "EXPENSE"] for P&L-only dimensions.
  appliesToAccountTypes Json    @default("[]")

  values  DimensionValue[]
  bridges DimensionSetValue[]

  createdAt DateTime @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("dimension")
}

model DimensionValue {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dimensionId String    @db.Uuid
  dimension   Dimension @relation(fields: [dimensionId], references: [id])
  code        String
  name        String

  bridges DimensionSetValue[]

  @@unique([dimensionId, code])
  @@index([tenantId])
  @@map("dimension_value")
}

// A deduplicated combination of dimension values. Each JournalLine references
// one DimensionSet. Two lines with identical (Department=ENG, Class=R&D)
// share the same DimensionSet row.
model DimensionSet {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Stable hash of sorted (dimensionId, dimensionValueId) pairs. Used for
  // dedup lookups during posting. Phase 4b: unique per [tenantId, hash]
  // so identical assignments in different tenants don't collide.
  hash     String

  values       DimensionSetValue[]
  journalLines JournalLine[]

  createdAt DateTime @default(now())

  @@unique([tenantId, hash])
  @@index([tenantId])
  @@map("dimension_set")
}

model DimensionSetValue {
  dimensionSetId   String         @db.Uuid
  dimensionId      String         @db.Uuid
  dimensionValueId String         @db.Uuid
  dimensionSet     DimensionSet   @relation(fields: [dimensionSetId], references: [id], onDelete: Cascade)
  dimension        Dimension      @relation(fields: [dimensionId], references: [id])
  dimensionValue   DimensionValue @relation(fields: [dimensionValueId], references: [id])

  @@id([dimensionSetId, dimensionId])
  @@map("dimension_set_value")
}

// =========================================================================
// Layer 4 — Posting Rules (table only; no rules registered in v1)
// =========================================================================
// A source event (e.g. NetSuite "Customer Invoice") maps to N GL-line
// templates, one per applicable book. With no rules registered, the posting
// function falls back to "post identically to every active book."

model PostingRule {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String  @db.Uuid
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceEventType String // e.g. "QBO_INVOICE"
  bookId          String  @db.Uuid
  book            Book    @relation(fields: [bookId], references: [id])
  ruleVersion     Int     @default(1)
  // GL-line template — accounts, signs, dimension mappings, etc.
  // Schema TBD when the first rule is authored.
  template        Json
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceEventType, bookId, ruleVersion])
  @@index([tenantId])
  @@map("posting_rule")
}

// =========================================================================
// Layer 5 — Custom Field Metadata
// =========================================================================
// The JSON content lives in `extensions` on each entity. THIS table just
// describes what's inside those JSON blobs so a UI can render forms and
// queries can use GIN indexes intelligently.

model CustomFieldDefinition {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @db.Uuid
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Which entity type this field attaches to ("party", "account", "item",
  // "gl_entry_header", "gl_entry_line", "invoice", ...).
  targetEntityType String
  fieldKey         String // key inside the extensions JSON
  label            String
  fieldType        CustomFieldType
  validation       Json? // e.g. { min: 0, max: 100 } or { regex: "^[A-Z]{2}$" }
  defaultValue     Json?
  sourceErpField   String? // original ERP field code (for round-trip)

  createdAt DateTime @default(now())

  @@unique([targetEntityType, fieldKey])
  @@index([tenantId])
  @@map("custom_field_definition")
}

enum CustomFieldType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  DATETIME
  ENUM
  REFERENCE
  JSON_VALUE
}

// =========================================================================
// Native Sub-Ledgers — owned, not delegated to specialty tools.
// =========================================================================
// Per the spec's "Own sub-ledgers natively" decision: AR/AP open-item
// lifecycles + fixed assets + leases + revenue contracts live HERE, not in
// Sage FAS / LeaseQuery / Zuora. Each has a book-aware attributes table
// keyed by (record_id, book_id) so the same physical asset/lease/contract
// can carry divergent useful life / classification / recognition timing
// across US_GAAP, US_TAX, and IFRS — the engine for book-tax differences.

// ---- AR (Accounts Receivable) -------------------------------------------
// A bill creates an AP open item; it is NOT itself AP. An invoice opens an
// AR open item; payments APPLY to the item; full application closes it.
// Sum of currentBalance for OPEN items per (entity, book) = AR control
// account balance (the invariant).

model ArOpenItem {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])
  partyId  String      @db.Uuid
  party    Party       @relation(fields: [partyId], references: [id])

  // The JournalEntry that opened this item (typically an invoice).
  openedByEntryId String       @db.Uuid
  openedByEntry   JournalEntry @relation("ArOpenedBy", fields: [openedByEntryId], references: [id])

  referenceNumber    String? // invoice number from the source system
  openedDate         DateTime       @db.Date
  dueDate            DateTime?      @db.Date
  originalAmount     Decimal        @db.Decimal(18, 4)
  currentBalance     Decimal        @db.Decimal(18, 4)
  currencyId         String
  status             OpenItemStatus @default(OPEN)
  // Which AR control account this rolls up to (denormalized for the
  // sum-of-open = control-balance invariant query).
  controlAccountCode String

  applications ArApplication[]

  // Ownership + audit. Same semantics as JournalEntry — see
  // docs/ownership-and-rules.md. ownerId is workflow-routing (which
  // collector is responsible), NOT access control.
  ownerId              String?   @db.Uuid
  ownerType            OwnerType @default(USER)
  createdBy            String?
  updatedBy            String?
  reassignmentLockedAt DateTime?

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Backref to RecordEvent audit log.
  recordEvents RecordEvent[] @relation("ArOpenItemEvents")

  @@index([ownerId])
  @@index([entityId, bookId, partyId, status])
  @@index([entityId, bookId, status, dueDate])
  @@index([tenantId])
  @@map("ar_open_item")
}

enum OpenItemStatus {
  OPEN
  PARTIAL
  APPLIED
  WRITTEN_OFF
  REOPENED
  VOID
}

model ArApplication {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @db.Uuid
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  openItemId       String       @db.Uuid
  openItem         ArOpenItem   @relation(fields: [openItemId], references: [id], onDelete: Cascade)
  appliedByEntryId String       @db.Uuid
  appliedByEntry   JournalEntry @relation("ArAppliedBy", fields: [appliedByEntryId], references: [id])
  appliedAmount    Decimal      @db.Decimal(18, 4)
  appliedDate      DateTime     @db.Date

  createdAt DateTime @default(now())

  @@index([openItemId])
  @@index([tenantId])
  @@map("ar_application")
}

// ---- AP (Accounts Payable) — mirror of AR -------------------------------

model ApOpenItem {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])
  partyId  String      @db.Uuid
  party    Party       @relation(fields: [partyId], references: [id])

  openedByEntryId String       @db.Uuid
  openedByEntry   JournalEntry @relation("ApOpenedBy", fields: [openedByEntryId], references: [id])

  referenceNumber    String?
  openedDate         DateTime       @db.Date
  dueDate            DateTime?      @db.Date
  originalAmount     Decimal        @db.Decimal(18, 4)
  currentBalance     Decimal        @db.Decimal(18, 4)
  currencyId         String
  status             OpenItemStatus @default(OPEN)
  controlAccountCode String

  applications ApApplication[]

  // Ownership + audit. Same semantics as ArOpenItem / JournalEntry — see
  // docs/ownership-and-rules.md. AP collector / approval workflow uses this.
  ownerId              String?   @db.Uuid
  ownerType            OwnerType @default(USER)
  createdBy            String?
  updatedBy            String?
  reassignmentLockedAt DateTime?

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Backref to RecordEvent audit log.
  recordEvents RecordEvent[] @relation("ApOpenItemEvents")

  @@index([ownerId])
  @@index([entityId, bookId, partyId, status])
  @@index([entityId, bookId, status, dueDate])
  @@index([tenantId])
  @@map("ap_open_item")
}

model ApApplication {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @db.Uuid
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  openItemId       String       @db.Uuid
  openItem         ApOpenItem   @relation(fields: [openItemId], references: [id], onDelete: Cascade)
  appliedByEntryId String       @db.Uuid
  appliedByEntry   JournalEntry @relation("ApAppliedBy", fields: [appliedByEntryId], references: [id])
  appliedAmount    Decimal      @db.Decimal(18, 4)
  appliedDate      DateTime     @db.Date

  createdAt DateTime @default(now())

  @@index([openItemId])
  @@index([tenantId])
  @@map("ap_application")
}

// ---- Fixed Assets ------------------------------------------------------

model FixedAsset {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])

  code                  String // asset tag, e.g. "LAPTOP-001"
  description           String
  category              String? // e.g. "COMPUTER_EQUIPMENT"
  vendorPartyId         String?          @db.Uuid
  vendor                Party?           @relation("FixedAssetVendor", fields: [vendorPartyId], references: [id])
  acquisitionDate       DateTime         @db.Date
  acquisitionCost       Decimal          @db.Decimal(18, 4)
  acquisitionCurrencyId String
  acquisitionCurrency   Currency         @relation("FixedAssetAcqCcy", fields: [acquisitionCurrencyId], references: [code])
  status                FixedAssetStatus @default(IN_SERVICE)
  disposalDate          DateTime?        @db.Date
  disposalProceeds      Decimal?         @db.Decimal(18, 4)

  // Which gross-cost asset account on the GL holds the original cost.
  // (Accumulated depreciation lives on the per-book attributes row.)
  assetAccountCode String // e.g. "1500" Computer Equipment

  bookAttributes FixedAssetBookAttributes[]

  // User attribution (DSR evidence). Set by the Server Action that creates
  // the asset (manual UI flow) / flips it on disposal; NetSuite imports and
  // pre-2026-06-05 rows leave them null — no human actor. Columns were
  // applied to the shared DB by fa-amort's reviewed raw SQL
  // (fa-amort prisma/sql/2026-06-05-attribution-schema.sql).
  createdBy  String? @db.Uuid
  disposedBy String? @db.Uuid

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([entityId, status])
  @@index([tenantId])
  // Physical index names are lowercase-folded — the 2026-06-05 raw SQL left
  // them unquoted. The maps pin the actual names so migrate diff stays clean.
  @@index([createdBy], map: "fixed_asset_createdby_idx")
  @@index([disposedBy], map: "fixed_asset_disposedby_idx")
  @@map("fixed_asset")
}

enum FixedAssetStatus {
  IN_SERVICE
  IDLE
  DISPOSED
  HELD_FOR_SALE
}

// Book-aware attributes. Same physical asset, divergent useful life /
// method / accumulated depreciation across books. This is THE pattern
// that produces book-tax differences for fixed assets.
model FixedAssetBookAttributes {
  assetId                 String             @db.Uuid
  asset                   FixedAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  bookId                  String             @db.Uuid
  book                    Book               @relation(fields: [bookId], references: [id])
  usefulLifeMonths        Int
  depreciationMethod      DepreciationMethod
  inServiceDate           DateTime           @db.Date
  salvageValue            Decimal            @default(0) @db.Decimal(18, 4)
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(18, 4)
  lastDepreciatedThrough  DateTime?          @db.Date

  // GL accounts used when the depreciation runner posts journal entries
  // for this book.
  depreciationExpenseAccountCode String // e.g. "8000" Depreciation Expense
  accumDepreciationAccountCode   String // e.g. "1510" Accum Dep contra-asset

  // User attribution (DSR evidence). Set by the Server Action that runs
  // depreciation through a given date; NetSuite-imported rows leave both
  // null. Applied to the shared DB by fa-amort's reviewed raw SQL
  // (fa-amort prisma/sql/2026-06-05-attribution-schema.sql).
  lastRunBy String?   @db.Uuid
  lastRunAt DateTime?

  @@id([assetId, bookId])
  @@index([bookId, lastDepreciatedThrough])
  // Lowercase physical name (unquoted in the 2026-06-05 raw SQL); the map
  // pins it so migrate diff stays clean.
  @@index([lastRunBy], map: "fab_lastrunby_idx")
  @@map("fixed_asset_book_attributes")
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DOUBLE_DECLINING
  MACRS_3_HY
  MACRS_5_HY
  MACRS_7_HY
  MACRS_15_HY
  UNITS_OF_PRODUCTION
  NONE // for non-depreciable assets (land)
}

// ---- Leases (ASC 842 / IFRS 16) -----------------------------------------

model Lease {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])

  code                      String // "LEASE-2026-001"
  description               String // "NYC office, 50 Hudson Yards"
  lessorPartyId             String?               @db.Uuid
  lessor                    Party?                @relation("LeaseLessor", fields: [lessorPartyId], references: [id])
  leaseStartDate            DateTime              @db.Date
  leaseEndDate              DateTime              @db.Date
  paymentFrequency          LeasePaymentFrequency @default(MONTHLY)
  paymentAmount             Decimal               @db.Decimal(18, 4)
  totalUndiscountedPayments Decimal               @db.Decimal(18, 4)
  currencyId                String
  currency                  Currency              @relation("LeaseCcy", fields: [currencyId], references: [code])
  status                    LeaseStatus           @default(ACTIVE)

  bookAttributes LeaseBookAttributes[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([tenantId])
  @@map("lease")
}

enum LeasePaymentFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum LeaseStatus {
  ACTIVE
  TERMINATED
  EXPIRED
}

enum LeaseClassification {
  OPERATING // ASC 842 / IFRS 16 — capitalize ROU + liability
  FINANCE // ASC 842 finance lease (formerly capital lease)
  SHORT_TERM // ≤12 months — expense as paid
  TAX_CASH_BASIS // US Tax: deduct cash payments, no capitalization
  NONE
}

model LeaseBookAttributes {
  leaseId String @db.Uuid
  lease   Lease  @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  bookId  String @db.Uuid
  book    Book   @relation(fields: [bookId], references: [id])

  classification        LeaseClassification
  discountRate          Decimal             @default(0) @db.Decimal(10, 6)
  rouAssetBalance       Decimal             @default(0) @db.Decimal(18, 4)
  leaseLiabilityBalance Decimal             @default(0) @db.Decimal(18, 4)
  lastAmortizedThrough  DateTime?           @db.Date

  // GL accounts used by the lease amortization posting.
  rouAccountCode       String? // ROU asset account
  liabilityAccountCode String? // lease liability account
  expenseAccountCode   String? // lease/rent expense account
  interestAccountCode  String? // for finance leases

  @@id([leaseId, bookId])
  @@map("lease_book_attributes")
}

// ---- Revenue Contracts (ASC 606 / IFRS 15) ------------------------------

model RevenueContract {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])

  code               String // contract number
  description        String
  customerPartyId    String                @db.Uuid
  customer           Party                 @relation("ContractCustomer", fields: [customerPartyId], references: [id])
  contractStartDate  DateTime              @db.Date
  contractEndDate    DateTime?             @db.Date
  totalContractValue Decimal               @db.Decimal(18, 4)
  currencyId         String
  currency           Currency              @relation("RevContractCcy", fields: [currencyId], references: [code])
  status             RevenueContractStatus @default(ACTIVE)

  performanceObligations PerformanceObligation[]
  bookAttributes         RevenueContractBookAttributes[]

  sourceSystem     String?
  sourceRecordType String?
  sourceRecordId   String?
  sourcePayload    Json?
  mappingVersion   String?
  extensions       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, code])
  @@index([tenantId])
  @@map("revenue_contract")
}

enum RevenueContractStatus {
  DRAFT
  ACTIVE
  AMENDED
  TERMINATED
  COMPLETED
}

enum RecognitionPattern {
  POINT_IN_TIME
  OVER_TIME_STRAIGHT
  OVER_TIME_USAGE
  OVER_TIME_MILESTONE
}

model PerformanceObligation {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId         String             @db.Uuid
  contract           RevenueContract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  sequenceNo         Int
  description        String
  ssp                Decimal            @db.Decimal(18, 4) // standalone selling price (allocated)
  recognitionPattern RecognitionPattern
  startDate          DateTime           @db.Date
  endDate            DateTime?          @db.Date
  recognizedToDate   Decimal            @default(0) @db.Decimal(18, 4)

  // GL accounts the rev-rec engine posts to when recognizing this PO.
  revenueAccountCode  String // e.g. "4000"
  deferredAccountCode String // e.g. "2200"

  // ASC 606 allocation columns, upstreamed from revenue-rec (its PR #17,
  // applied to the shared DB 2026). revenue-rec's allocator/scheduler and
  // NS mappers read + write these; ledger-core owns the definitions.

  // Allocated transaction price for this PO. When null, revenue-rec's
  // allocator falls back to SSP (proportional allocation default). When
  // set, this is the authoritative amount the recognition engine schedules.
  allocatedAmount Decimal? @db.Decimal(18, 4)

  // How the transaction price got allocated to this PO (ASC 606 ¶78).
  // Null = unspecified (pre-migration data + AI-extracted contracts that
  // didn't surface the method).
  allocationMethod AllocationMethod?

  // Fair-value evidence type (ASC 606 ¶77, formerly ASC 605 VSOE
  // hierarchy). Tracked for audit-trail purposes; does not affect
  // recognition math. Null = unspecified.
  fairValueMethod FairValueMethod?

  // Item quantity. Defaults to 1 (the dominant case: SSP carries the
  // per-line total, not per-unit).
  quantity Decimal @default(1) @db.Decimal(18, 4)

  @@unique([contractId, sequenceNo])
  @@map("performance_obligation")
}

// ASC 606 ¶78 allocation methods. PROPORTIONAL is the default
// (relative-SSP); RESIDUAL is permitted when SSP for one or more
// POs is uncertain; MANUAL captures auditor-required overrides.
enum AllocationMethod {
  PROPORTIONAL
  RESIDUAL
  MANUAL
}

// ASC 606 ¶77 fair-value evidence hierarchy (carried over from
// the ASC 605 VSOE/TPE/ESP framework for continuity in audit
// trails). RESIDUAL means SSP was determined by the residual
// approach (total minus observable SSPs of other POs).
enum FairValueMethod {
  ESP
  VSOE
  TPE
  RESIDUAL
}

model RevenueContractBookAttributes {
  contractId String          @db.Uuid
  contract   RevenueContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  bookId     String          @db.Uuid
  book       Book            @relation(fields: [bookId], references: [id])

  // GAAP/IFRS use ACCRUAL (ASC 606). Tax may use CASH for certain entities.
  recognitionBasis     RecognitionBasis @default(ACCRUAL)
  cumulativeRecognized Decimal          @default(0) @db.Decimal(18, 4)

  @@id([contractId, bookId])
  @@map("revenue_contract_book_attributes")
}

enum RecognitionBasis {
  ACCRUAL
  CASH
}

// =========================================================================
// Ownership, queues, audit log, and reassignment rules engine
// =========================================================================
//
// Universal ownership: every transactional record gets ownerId (User OR Queue,
// discriminated by ownerType), defaults to createdBy at insert, mutable only
// via explicit reassignment. Audit columns (createdBy, updatedBy, updatedAt)
// are separate and immutable-or-write-only. See docs/ownership-and-rules.md.
//
// Sharing semantics in ERP modules: ownerId is for workflow routing and "my
// queue" views, NOT for access control. Module/operation permissions and
// entity/book scope handle sharing. Future CRM modules MAY use ownership as
// a sharing primitive following Salesforce conventions — that's a per-module
// choice and must be documented when those modules land.

enum OwnerType {
  USER
  QUEUE
}

// ownerId is polymorphic (User OR Queue, discriminated by ownerType), so
// JournalEntry doesn't have a real FK relation to User — only ownerType=USER
// rows point at User.id. The application enforces the polymorphic invariant.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  // SOC 2 CC6 — Confidentiality TSC. HMAC-SHA256 search-hash for
  // the encrypted `email` column. Populated by the encrypted-fields
  // Prisma extension on write; queried by `emailLookupKeyForUser`
  // (see src/lib/soc2/index.ts) on every login + admin email
  // lookup. See docs/design/deterministic-encryption.md.
  //
  // Nullable during the Phase 2 rollout window so existing pre-
  // rollout rows (with NULL hash) don't block writes. Backfill via
  // scripts/encrypt-user-emails.ts. Tightened to NOT NULL in the
  // Phase 3 cleanup PR once every row has a hash.
  emailHash     Bytes?    @unique
  displayName   String
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?

  // Multi-tenancy: a User can belong to N Tenants via TenantMembership.
  // User itself is global (no tenantId) — login lookup is global by email.
  tenantMemberships TenantMembership[]

  queueMemberships            QueueMember[]
  recordEvents                RecordEvent[]
  notifications               Notification[]             @relation("NotificationRecipient")
  notificationsActed          Notification[]             @relation("NotificationActor")
  auditEvents                 AuditLog[]                 @relation("AuditLogActor")
  journalEntryNotes           JournalEntryNote[]
  // BlackLine arc Phase 1: a user can be the preparer on N recons, the
  // reviewer on N recons, and the uploader of N attachments. CPA
  // segregation of duties means preparer != reviewer on the same recon
  // (enforced at the Server Action layer, not the schema).
  reconciliationsPrepared     Reconciliation[]           @relation("ReconPreparer")
  reconciliationsReviewed     Reconciliation[]           @relation("ReconReviewer")
  reconciliationAttachments   ReconciliationAttachment[]
  // BlackLine arc Phase 2: close-task calendar. A user can own N close
  // tasks (assigned executor), complete N, and author N comments.
  closeTasksOwned             CloseTask[]                @relation("CloseTaskOwner")
  closeTasksCompleted         CloseTask[]                @relation("CloseTaskCompleter")
  closeTaskComments           CloseTaskComment[]
  closeTaskStateChangesMade   CloseTaskStateChange[]
  // Notifications arc: which channels did this user create.
  notificationChannelsCreated NotificationChannel[]
  // Team management: invites this user originated (audit trail).
  invitesSent                 TenantInvite[]             @relation("InvitedBy")
  // BlackLine arc Phase 3: flux / variance analysis.
  fluxStatementsFinalized     FluxStatement[]            @relation("FluxFinalizer")
  fluxLineComments            FluxLine[]                 @relation("FluxLineCommenter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_user")
}

model Queue {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @db.Uuid
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Phase 4b: unique per tenant. Each tenant defines its own queue codes.
  code                 String // e.g. "AR_COLLECTIONS", "GL_UNASSIGNED"
  name                 String
  description          String?
  // When isUnassignedFallback is true, this queue is the module's dead-letter
  // queue — rules fall back to it when their primary target can't resolve.
  // Exactly one queue per module should carry this flag.
  isUnassignedFallback Boolean   @default(false)
  isActive             Boolean   @default(true)
  deletedAt            DateTime?

  members QueueMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("queue")
}

model QueueMember {
  queueId String @db.Uuid
  queue   Queue  @relation(fields: [queueId], references: [id])
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@id([queueId, userId])
  @@map("queue_member")
}

// Universal audit log for ownership changes + state-machine transitions.
// One row per event; append-only; never edited or deleted.
//
// recordType is a stable string matching the Prisma model name
// ("JournalEntry", "ArOpenItem", etc.). recordId is the target record's UUID.
// previousValue + newValue are flexible JSON to handle different event shapes
// (owner change carries ownerId; state change carries status; etc.).
model RecordEvent {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String          @db.Uuid
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recordType    String // e.g. "JournalEntry"
  recordId      String          @db.Uuid
  eventType     RecordEventType
  previousValue Json?
  newValue      Json?
  actorUserId   String?         @db.Uuid
  actor         User?           @relation(fields: [actorUserId], references: [id])
  // For rule-fired events: "rule:<ruleId>:v<version>". For manual:
  // "manual:<freeform>". For lifecycle: "lifecycle:<event>".
  actorReason   String

  // Specific backrefs per ownership-bearing model; add as adoption grows.
  // Multiple FK columns rather than polymorphic — one is set per row based
  // on recordType, the others are null. Indexed by (recordType, recordId)
  // for queries that don't care about which model.
  journalEntryId String?       @db.Uuid
  journalEntry   JournalEntry? @relation("JournalEntryEvents", fields: [journalEntryId], references: [id])
  arOpenItemId   String?       @db.Uuid
  arOpenItem     ArOpenItem?   @relation("ArOpenItemEvents", fields: [arOpenItemId], references: [id])
  apOpenItemId   String?       @db.Uuid
  apOpenItem     ApOpenItem?   @relation("ApOpenItemEvents", fields: [apOpenItemId], references: [id])

  occurredAt DateTime @default(now())

  @@index([recordType, recordId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("record_event")
}

enum RecordEventType {
  CREATED
  OWNER_CHANGED
  STATE_CHANGED
  REASSIGNMENT_LOCKED
  REASSIGNMENT_UNLOCKED
  ABANDONED
}

// AuditLog — security & access events.
//
// Complements RecordEvent (which tracks state changes on tracked records).
// AuditLog records the events SOC 2 CC6/CC7 auditors expect to see:
//   - Login + logout + access denials
//   - Privileged actions (period close, user lifecycle changes, admin reset)
//   - Internal-API token use (success + rejection)
//   - Data exports (CSV/PDF downloads)
//   - Configuration changes
//   - Anomalies the system itself catches
//
// Designed for long retention (12+ months for SOC 2). The actorEmail
// column duplicates the join target so the log survives a User row
// deletion — auditors expect immutability of the trail.
//
// metadata is intentionally Json — different event types carry different
// shapes. Conventions documented in src/lib/audit/log.ts.
model AuditLog {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // tenantId is critical for tenant-scoped events (PRIVILEGED_ACTION,
  // JE posts, DATA_EXPORT, etc.) — cross-tenant audit log visibility
  // would leak which actions other firms took. Quarterly access reviews
  // scope by tenant.
  //
  // Intentionally NULLABLE so pre-identity events (TOKEN_REJECTED with
  // garbage Bearer, missing Bearer, malformed token) can still be logged
  // without forcing a synthetic tenant assignment. These platform-level
  // events are visible only to platform admins (default-tenant owner).
  // Phase 4b kept this column nullable; every other tenant-scoped table
  // is NOT NULL.
  tenantId    String?        @db.Uuid
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventType   AuditEventType
  // Who: actor (when known) + denormalized email + network identity
  actorUserId String?        @db.Uuid
  actor       User?          @relation("AuditLogActor", fields: [actorUserId], references: [id])
  // Captured separately so the log survives a User deletion. Required
  // for actor-identifiable events (LOGIN_*, PRIVILEGED_ACTION, etc.);
  // null for system events (CONFIG_CHANGE on boot, etc.).
  actorEmail  String?
  // From x-forwarded-for (Vercel) or remoteAddress. Best-effort; clients
  // can spoof. Required reading for unusual-access investigations.
  ipAddress   String?
  userAgent   String?
  // What: resource + action
  // resource is a stable string ("JournalEntry", "Period", "User",
  // "FixedAsset", "DepreciationRun", etc.). resourceId is the target
  // record's code or UUID (whichever's more readable in the log).
  resource    String?
  resourceId  String?
  // action is free-form verbal: "post", "close", "reopen", "deactivate",
  // "download-csv", "view-report", "issue-token", etc. Match action
  // names to the Server Action / endpoint that wrote the log entry.
  action      String
  outcome     AuditOutcome   @default(SUCCESS)
  // Context: structured fields the event-type expects. See
  // src/lib/audit/log.ts for the convention per event type.
  metadata    Json?
  occurredAt  DateTime       @default(now())

  // Indexes drive the common audit queries:
  //   - "What did Carla do this week?" → (actorUserId, occurredAt)
  //   - "Show me all login failures last 30 days" → (eventType, occurredAt)
  //   - "Who accessed JE NORTHWIND-US_GAAP-00042?" → (resource, resourceId)
  @@index([actorUserId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([resource, resourceId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("audit_log")
}

enum AuditEventType {
  LOGIN_SUCCESS // setCurrentUser succeeded
  LOGIN_FAILURE // setCurrentUser rejected (unknown user, inactive)
  LOGOUT // clearCurrentUser
  ACCESS_DENIED // requireAdmin failed; non-admin tried admin action
  PRIVILEGED_ACTION // period close, user lifecycle, admin reset, etc.
  DATA_EXPORT // CSV/PDF download, bulk read
  DATA_ERASURE // GDPR Art. 17 PII redaction — regulator-queryable proof the request was honored
  TOKEN_USED // /api/internal/* request authenticated via INTERNAL_API_TOKEN
  TOKEN_REJECTED // /api/internal/* request failed Bearer-token check
  CONFIG_CHANGE // env-var change, schema migration applied
  SECURITY_EVENT // anything anomalous: rate-limit hit, repeated failures, etc.
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  ANOMALOUS
}

// Reassignment rules. Versioned + audited, same discipline as PostingRule.
// criteriaJson holds the DSL tree (see src/lib/rules/types.ts for the shape).
// First-match-wins by priority (lower = earlier). Validated at write time
// via src/lib/rules/validator.ts.
model ReassignmentRule {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String               @db.Uuid
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ruleId                String // human-readable, stable across versions
  ruleVersion           Int                  @default(1)
  recordType            String // "JournalEntry", "ArOpenItem", etc.
  trigger               ReassignmentTrigger
  // For ON_UPDATE: which fields changing should re-evaluate this rule.
  // Empty array = evaluate on any field change (use sparingly).
  triggerFields         String[]             @default([])
  // For ON_STATE_TRANSITION: which (from, to) state pair.
  triggerStateFrom      String?
  triggerStateTo        String?
  // For ON_USER_LIFECYCLE: which event triggers ("USER_DEACTIVATED", "ROLE_REMOVED").
  triggerLifecycleEvent String?
  // For ON_SCHEDULE: cron expression (UTC).
  triggerSchedule       String?
  priority              Int // lower fires earlier; ties = validation error
  // For declarative rules.
  criteriaJson          Json?
  // For code rules. References a function name registered in
  // src/lib/rules/registry.ts. NOT user-editable — code review required.
  ruleType              ReassignmentRuleType @default(DECLARATIVE)
  codeImplementation    String?
  // Target: USER, QUEUE, or DERIVED (code-rule decides at evaluation time).
  targetType            OwnerType?
  targetId              String?              @db.Uuid
  // Notification preferences (optional).
  notifyOwner           Boolean              @default(false)
  notifyTarget          Boolean              @default(true)
  notifyTemplateId      String?

  isActive     Boolean   @default(true)
  authoredBy   String?
  authoredAt   DateTime  @default(now())
  supersededAt DateTime?

  @@unique([ruleId, ruleVersion])
  @@index([recordType, isActive, priority])
  @@index([tenantId])
  @@map("reassignment_rule")
}

enum ReassignmentRuleType {
  DECLARATIVE
  CODE
}

enum ReassignmentTrigger {
  ON_INSERT
  ON_UPDATE
  ON_STATE_TRANSITION
  ON_SCHEDULE
  ON_USER_LIFECYCLE
}

// User-facing notifications. Emitted by the rules engine + reassignment
// service to surface "something happened" — e.g., "A new $25K AR item
// was assigned to your queue."
//
// Recipient is always a USER (not a queue). When a record is assigned
// to a queue, the notification emitter fans out one row per queue
// member. This is intentionally simple — production systems would add
// per-user preferences (mute, batch, route to email/Slack) but this is
// the substrate those layer on.
//
// link is a relative URL the bell dropdown opens (e.g., "/ar" or
// "/journal-entries/abc"). recordType + recordId let the bell group
// multiple notifications for the same target.
model Notification {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @db.Uuid
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipientUserId String @db.Uuid
  recipient       User   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  category NotificationCategory
  title    String
  body     String?
  link     String?

  // Audit: who/what triggered this notification.
  // sourceRuleId references a ReassignmentRule.ruleId (string, since
  // rules are versioned and we want to track which rule version fired).
  // actorUserId is the User who took the action (manual reassignment)
  // or null for engine-fired notifications.
  sourceRuleId String?
  actorUserId  String? @db.Uuid
  actor        User?   @relation("NotificationActor", fields: [actorUserId], references: [id])

  // Target record. Lets the bell group repeated notifications about
  // the same record and link to its detail page.
  recordType String?
  recordId   String? @db.Uuid

  seenAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientUserId, seenAt, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([tenantId, createdAt])
  @@map("notification")
}

enum NotificationCategory {
  REASSIGNMENT // record's owner changed (manual or rule-fired)
  APPROVAL_NEEDED // record is in your queue awaiting action
  ORPHAN_DETECTED // a record you previously owned is now an orphan
  SYSTEM // catch-all for engine-level events
}

// =========================================================================
// BlackLine arc — Phase 2: Close Task Calendar
// =========================================================================
//
// Models the controller's monthly close checklist as data instead of an
// outside spreadsheet. Each (entity, book, period) gets N CloseTask rows
// instantiated from CloseTaskTemplate at period-open time. Task status
// flows: NOT_STARTED → IN_PROGRESS → DONE (or → BLOCKED, or → WAIVED).
//
// Dependencies are encoded as a self-FK array (dependsOnIds: UUID[]).
// Cycle prevention happens at write-time in the Server Action — the
// schema can't enforce a DAG via Prisma. Closing a period requires all
// `requiredForClose=true` tasks to be terminal (DONE/WAIVED).
//
// Design doc: docs/blackline-arc-design.md → Phase 2.

enum CloseTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
  WAIVED
}

enum CloseTaskCategory {
  ACCRUAL
  RECON
  DEPRECIATION
  FX
  REVENUE
  INVENTORY
  TAX
  REPORTING
  ADMIN
}

model CloseTask {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // entityId/bookId nullable so a tenant-wide admin task ("send close-
  // complete notification") can apply across all (entity, book) tuples
  // for the period without N duplicate rows. The instantiator decides
  // the fan-out shape: BS-tied tasks (recon AR) are per-(entity, book);
  // org-wide tasks (post-mortem) are null/null.
  entityId String?      @db.Uuid
  entity   LegalEntity? @relation(fields: [entityId], references: [id])
  bookId   String?      @db.Uuid
  book     Book?        @relation(fields: [bookId], references: [id])
  periodId String       @db.Uuid
  period   Period       @relation(fields: [periodId], references: [id])

  // Links back to the template this row was instantiated from. Null when
  // the task was created ad-hoc (a controller adds a one-off "investigate
  // unusual JE in Misc Income"). NOT a FK because deleting a template
  // shouldn't cascade-wipe historical task records — the audit trail.
  templateKey String?
  name        String
  description String?
  category    CloseTaskCategory

  status           CloseTaskStatus @default(NOT_STARTED)
  // When true, the period-close gate refuses if this task isn't terminal.
  requiredForClose Boolean         @default(true)

  // Polymorphic owner — User or Queue, discriminated by ownerType.
  // ownerId is application-enforced, not FK'd, mirroring the same
  // pattern on JournalEntry / ArOpenItem (see docs/ownership-and-rules.md).
  ownerId   String?    @db.Uuid
  ownerType OwnerType?

  // Due date computed at instantiation from
  // (period.endsOn + dueOffsetDays). Negative = before period end.
  // Stored as DateTime so a task in a week-of-month calendar still
  // gets a meaningful due moment.
  dueOffsetDays Int?
  dueAt         DateTime?

  // Self-reference dependency list. Cycle prevention is enforced in
  // the Server Action (Prisma can't validate a DAG at the schema level).
  // Empty array = no predecessors.
  dependsOnIds String[] @db.Uuid

  blockedReason String?
  completedById String?   @db.Uuid
  completer     User?     @relation("CloseTaskCompleter", fields: [completedById], references: [id])
  completedAt   DateTime?
  // Free-text evidence link the user pastes when marking DONE — URL to a
  // workpaper, bank statement screenshot, etc. Not a typed Attachment
  // (those live on Reconciliation per Phase 1); free-form is enough at
  // the task tier and keeps the UI simple.
  evidenceUrl   String?
  evidenceNote  String?

  owner        User?                  @relation("CloseTaskOwner", fields: [ownerId], references: [id])
  comments     CloseTaskComment[]
  // Append-only state-change log (migration 0011). One row per status
  // transition + one row at instantiation (fromStatus=null).
  stateChanges CloseTaskStateChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, periodId, status])
  @@index([ownerId])
  @@index([dueAt])
  @@map("close_task")
}

// Per-tenant catalog of recurring tasks. seedCloseTaskTemplates ships
// the ~50 BlackLine-standard rows; controllers can disable or add
// custom templates per tenant.
model CloseTaskTemplate {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Stable identifier — "ACCRUE_PAYROLL", "RUN_DEPRECIATION".
  // Templates instantiate by key, not id, so a re-seed against a fresh
  // tenant gives matching dependsOnKeys without UUID juggling.
  key         String
  name        String
  description String?
  category    CloseTaskCategory

  defaultOwnerId       String?    @db.Uuid
  defaultOwnerType     OwnerType?
  defaultDueOffsetDays Int? // relative to period.endsOn
  requiredForClose     Boolean    @default(true)

  // Dependency list by KEY (not ID) — resolved to ids at instantiation
  // time. This makes the seed file portable: a fresh tenant gets the
  // same predecessor wiring without needing to know the new UUIDs.
  defaultDependsOnKeys String[]

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, active])
  @@map("close_task_template")
}

// Comment thread on a close task. Body encrypted via the PrismaExtension
// confidential-column path when wired in (see docs/blackline-arc-design.md
// → "Confidentiality wire-up"). Stored as plain Text in v1.
model CloseTaskComment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  closeTaskId String    @db.Uuid
  closeTask   CloseTask @relation(fields: [closeTaskId], references: [id], onDelete: Cascade)

  body     String
  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([closeTaskId])
  @@index([tenantId])
  @@map("close_task_comment")
}

// Append-only state transition log for CloseTask. Migration 0011.
// Closes a documented v1.18 limitation: the recurring-blockers helper
// in src/lib/close/retrospective.ts was current-snapshot only, so a
// template that hit BLOCKED four periods ago and was since unblocked
// would not appear. With this table, the replay walker counts
// EVER-blocked, not currently-blocked.
//
// Write protocol: every status-mutating Server Action wraps the
// `closeTask.update` + state-change insert in one $transaction. The
// `changedById` field is REQUIRED for live transitions; nullable only
// to permit the backfill migration to land an initial row for every
// pre-existing task without inventing a fake actor.
model CloseTaskStateChange {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  closeTaskId String    @db.Uuid
  closeTask   CloseTask @relation(fields: [closeTaskId], references: [id], onDelete: Cascade)

  // fromStatus is null for the initial INSTANTIATE row only.
  fromStatus CloseTaskStatus?
  toStatus   CloseTaskStatus
  // Optional context. Populated for BLOCKED (the blockedReason value)
  // and WAIVED (the waive reason). Always null for start/complete/
  // unblock to avoid noise.
  reason     String?

  // Nullable to support the migration backfill — rows minted for pre-
  // existing tasks have no real actor. All NEW writes through the
  // recordStateChange helper require a non-null value (enforced in
  // the helper, not the schema, so backfill stays clean).
  changedById String?  @db.Uuid
  changedBy   User?    @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([closeTaskId, changedAt])
  @@index([tenantId, changedAt])
  @@index([tenantId, toStatus])
  @@map("close_task_state_change")
}

// =========================================================================
// BlackLine arc — Phase 3: Flux / Variance Analysis
// =========================================================================

enum FluxStatementStatus {
  DRAFT
  FINALIZED
}

enum FluxLineStatus {
  IMMATERIAL
  NEEDS_COMMENT
  EXPLAINED
  WAIVED
}

model FluxStatement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])

  fromPeriodId String @db.Uuid
  fromPeriod   Period @relation("FluxFromPeriod", fields: [fromPeriodId], references: [id])
  toPeriodId   String @db.Uuid
  toPeriod     Period @relation("FluxToPeriod", fields: [toPeriodId], references: [id])

  absoluteThreshold Decimal @default(0) @db.Decimal(20, 4)
  percentThreshold  Decimal @default(0) @db.Decimal(8, 4)

  status FluxStatementStatus @default(DRAFT)

  finalizedBy String?   @db.Uuid
  finalizer   User?     @relation("FluxFinalizer", fields: [finalizedBy], references: [id])
  finalizedAt DateTime?

  lines FluxLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, bookId, fromPeriodId, toPeriodId])
  @@index([tenantId, toPeriodId, status])
  @@map("flux_statement")
}

model FluxLine {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  statementId String        @db.Uuid
  statement   FluxStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  priorAmount   Decimal  @db.Decimal(20, 4)
  currentAmount Decimal  @db.Decimal(20, 4)
  deltaAmount   Decimal  @db.Decimal(20, 4)
  deltaPercent  Decimal? @db.Decimal(12, 4)

  status FluxLineStatus @default(IMMATERIAL)

  commentary   String?
  commentaryBy String?   @db.Uuid
  commenter    User?     @relation("FluxLineCommenter", fields: [commentaryBy], references: [id])
  commentaryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([statementId, accountId])
  @@index([statementId, status])
  @@index([tenantId])
  @@map("flux_line")
}

// =========================================================================
// DB-level invariants live in prisma/migrations/0001_constraints/migration.sql
// =========================================================================
//
//   - JournalLine: (debit > 0 AND credit = 0) OR (debit = 0 AND credit > 0)
//   - JournalLine: debit >= 0 AND credit >= 0
//   - JournalEntry: a POSTED entry must reference a non-CLOSED PeriodClose
//     (enforced in posting function; DB check is per-(entity,book,period)
//     and requires a deferrable trigger; out of scope for the first commit).
//
// See docs/universal-schema.md for the architectural rationale and the
// remaining layers' build plan.

// ─────────────────────────────────────────────────────────────────────────────
// BlackLine arc — Phase 1: Account Reconciliations
//
// The workflow shell BlackLine's whole product is built around. One
// Reconciliation row per (entity, book, period, account). Preparer ties out
// GL balance to supporting documentation, signs, hands off to reviewer.
// Reviewer signs OR sends back. Period close refuses to advance until every
// active BS account in the tenant is RECONCILED (or WAIVED by admin).
//
// Design doc: docs/blackline-arc-design.md
// Sign-off shape (single vs preparer→reviewer) is per-recon, default from
// ReconciliationConfig.defaultRequiresReview, overridable per Account.
// Period-close gate composition with Phases 2 + 3 documented in design doc.
// ─────────────────────────────────────────────────────────────────────────────

enum ReconStatus {
  OPEN // auto-created, not yet started
  IN_PROGRESS // preparer is working
  PREPARED // preparer signed; ready for reviewer (only when requiresReview)
  RECONCILED // signed off (terminal — closes the period-close gate)
  EXCEPTION // diff > tolerance; disposition required
  WAIVED // admin marked not-applicable for this period
}

model Reconciliation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // The scope tuple. Composite-unique so re-running the auto-instantiator
  // (Phase 1 PR 6) is idempotent.
  entityId  String      @db.Uuid
  entity    LegalEntity @relation(fields: [entityId], references: [id])
  bookId    String      @db.Uuid
  book      Book        @relation(fields: [bookId], references: [id])
  periodId  String      @db.Uuid
  period    Period      @relation(fields: [periodId], references: [id])
  accountId String      @db.Uuid
  account   Account     @relation(fields: [accountId], references: [id])

  // Frozen at sign-off so the reviewer sees the same numbers the preparer
  // signed against — even if a JE backs into the period afterward.
  // `glBalance` is the trial-balance number; `supportingBalance` is what
  // the operator typed in (Phase 1) or what the sub-ledger says (Phase 1
  // PR 7 auto-pull). `reconciledDiff` is computed = gl − supporting and
  // stored so a SQL sort by "biggest disagreement" stays cheap.
  glBalance         Decimal  @db.Decimal(20, 4)
  supportingBalance Decimal?
  reconciledDiff    Decimal?
  // Per-recon tolerance. Inherited from Account.reconTolerance (which
  // inherits from ReconciliationConfig.defaultTolerance). Stored on the
  // row so changing the tenant default later doesn't retroactively flip
  // signed-off recons in or out of EXCEPTION.
  tolerance         Decimal  @default(0) @db.Decimal(20, 4)

  status         ReconStatus @default(OPEN)
  // Decision #2 wiring: false = single sign-off (preparer's mark =
  // RECONCILED); true = preparer→reviewer chain (PREPARED waits for
  // reviewer). Frozen at recon-open time. Default value supplied by the
  // create-action from Account.requiresReconReview → ReconciliationConfig
  // → true (BlackLine standard).
  requiresReview Boolean     @default(true)

  preparedBy String?   @db.Uuid
  preparer   User?     @relation("ReconPreparer", fields: [preparedBy], references: [id])
  preparedAt DateTime?
  reviewedBy String?   @db.Uuid
  reviewer   User?     @relation("ReconReviewer", fields: [reviewedBy], references: [id])
  reviewedAt DateTime?

  // Encrypted via the existing PrismaExtension confidential-column path
  // (wired in PR 4 when notes get a real UI). Stays plain Text in schema.
  notes String?

  // Soft reference: RecordEvent.recordType = "Reconciliation",
  // .recordId = this id. No Prisma relation — RecordEvent is the
  // tenant-wide event journal used by ownership, JE notes, etc.
  attachments ReconciliationAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotent auto-instantiation on first visit to /close/reconciliations.
  @@unique([entityId, bookId, periodId, accountId])
  @@index([tenantId, periodId, status])
  @@index([periodId, status])
  @@map("reconciliation")
}

model ReconciliationAttachment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reconciliationId String         @db.Uuid
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  filename    String
  contentType String
  // Encrypted bytes via PrismaExtension (wired in PR 4). Self-contained
  // storage — no S3 vendor dependency. Worst case: 5 MB CSV × 100
  // accounts × 12 months = 6 GB tenant-wide. Acceptable at portfolio
  // scale; revisit if customer onboards with 500+ accounts.
  payload     Bytes
  sizeBytes   Int

  uploadedById String   @db.Uuid
  uploader     User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([reconciliationId])
  @@index([tenantId])
  @@map("reconciliation_attachment")
}

// Per-tenant default sign-off shape + default tolerance. Per-account
// override stored on Account.requiresReconReview + Account.reconTolerance.
// Resolution order documented in docs/blackline-arc-design.md.
model ReconciliationConfig {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @unique @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  defaultRequiresReview Boolean @default(true)
  defaultTolerance      Decimal @default(0) @db.Decimal(20, 4)

  updatedAt DateTime @updatedAt

  @@map("reconciliation_config")
}

// =========================================================================
// Notifications arc — Slack/etc outbound delivery
// =========================================================================

enum NotificationChannelType {
  SLACK
  // Future: EMAIL, MICROSOFT_TEAMS, WEBHOOK_GENERIC. The schema is
  // typed so multiple per tenant can fan out the same alert.
}

// Dispatch cadence. The IMMEDIATE cron (every 15m business hours) and
// the DIGEST_DAILY cron (once daily 09:00 UTC) read disjoint slices of
// this enum, so a channel belongs to exactly one cadence at a time —
// flip the mode on the channel to move it between them.
enum NotificationChannelMode {
  IMMEDIATE
  DIGEST_DAILY
}

// A configured outbound delivery target (Slack webhook). The
// `webhookUrl` column stores the application-layer AES-256-GCM
// ciphertext from src/lib/notifications/crypto.ts — never plaintext.
// Operators see the masked URL (maskWebhookUrl) in the admin UI.
model NotificationChannel {
  id       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String                  @db.Uuid
  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type     NotificationChannelType
  name     String

  // Encrypted via src/lib/notifications/crypto.ts (AES-256-GCM, IV +
  // tag + ciphertext packed into one base64 string). Never decrypted
  // on the read path — only the cron dispatcher decrypts at send time.
  webhookUrl String

  // Which severities push to this channel. JSON array of values from
  // `AlertSeverity` (high / medium / low). Empty → all severities.
  severityFilter String[]

  // IMMEDIATE = the per-alert dispatcher fires every 15m and pings on
  // every NEW alert. DIGEST_DAILY = the digest dispatcher fires once
  // daily and batches all NEW alerts since the last successful digest
  // into ONE Slack message. Existing channels default to IMMEDIATE so
  // current behavior is preserved post-migration.
  mode NotificationChannelMode @default(IMMEDIATE)

  enabled Boolean @default(true)

  // Audit ownership: who set this up. Used in the admin UI's
  // "created by" column. Audit-trail correlation goes through
  // the audit_log row written on createChannel.
  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispatches NotificationDispatch[]

  @@index([tenantId, enabled])
  @@index([mode, enabled])
  @@map("notification_channel")
}

// Per-(channel, alert) idempotency record. The cron dispatcher
// upserts one row when an alert is sent; if a row already exists,
// the alert is skipped (already pinged for this period). Operators
// re-trigger by deleting the matching dispatch row, OR by changing
// the alert's source data so it gets a new id.
model NotificationDispatch {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  channelId String              @db.Uuid
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // The alert.id from getCloseAlerts (e.g. "recon:<uuid>",
  // "task:<uuid>", "flux:<uuid>"). Plain text — the underlying record
  // ids are surrogate UUIDs, not PII.
  alertFingerprint String

  // Pillar + severity captured at send time. Useful for audit replay
  // ("which severities have we pinged this month") without rejoining
  // the source data.
  pillar   String
  severity String

  // HTTP status from Slack — 200 on success, anything else on the
  // failure leg of SlackSendResult. Kept for forensic queries.
  sendStatus Int?
  sendError  String?

  sentAt DateTime @default(now())

  // Dedupe: a given (channel, alert) tuple sends at most once.
  @@unique([channelId, alertFingerprint])
  @@index([tenantId, sentAt])
  @@map("notification_dispatch")
}

/// Transactional email log — one row per attempted send, whatever the
/// outcome. This is the operator's answer to "did this customer actually
/// get their invite?" without grepping provider dashboards. Harvested
/// from PR #46 (slice ② of the mega-branch harvest); templates and
/// senders arrive with their consuming slices (team-invites, approvals,
/// owner-transfer).
model EmailDelivery {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Tenant the email is on behalf of. Null for platform-level emails
  /// (no tenant context). SetNull on tenant delete — the delivery record
  /// outlives the tenant, same rationale as audit_log's denormalization.
  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// Recipient address. Encrypted at rest (random-IV AES-GCM) via the
  /// encrypted-fields extension; equality lookups go through toEmailHash,
  /// the same pattern as app_user.email/emailHash.
  toEmail     String
  /// HMAC-SHA256 search hash of the normalized recipient. Nullable (null
  /// until the deterministic key is configured), NOT unique — many
  /// deliveries per recipient is the normal case.
  toEmailHash Bytes?

  /// Stable template identifier — "tenant_invite", "je_approved",
  /// "owner_transfer_offered", etc. Lets us answer "how many invites
  /// went out this week?" without parsing subjects.
  template String
  /// Subject + bodies are literal email content (invite tokens, JE
  /// context, people's names) — encrypted at rest via the extension.
  subject  String
  bodyText String?
  bodyHtml String?

  status       EmailDeliveryStatus
  /// Provider message id (Resend's response.id when DELIVERED).
  providerId   String?
  /// Provider error detail on FAILED. Stored for diagnosis, never logged.
  errorMessage String?
  /// Template-specific payload (inviteId, entryId, …) for audit + replay.
  metadata     Json?
  sentAt       DateTime            @default(now())

  @@index([tenantId, sentAt])
  @@index([toEmailHash, sentAt])
  @@map("email_delivery")
}

enum EmailDeliveryStatus {
  DELIVERED // Provider accepted the message
  LOGGED_ONLY // No RESEND_API_KEY set; row persisted for visibility
  FAILED // Provider rejected (rate limit, bad recipient, etc.) or unreachable
}

/// Invite-by-email into a tenant. Flow: an ADMIN+ invites an address;
/// the invite holds a random single-use token; the accept URL
/// (/invites/accept?token=...) verifies the signed-in user's email
/// matches the invite's (case-insensitively — no hijacking), creates
/// the TenantMembership at the stored role, and flips the invite to
/// ACCEPTED. Invites lazy-expire after expiresAt (default 14 days).
/// Harvested from PR #46 (slice ③).
model TenantInvite {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Email the invite was sent to. Lowercased on insert; encrypted at
  /// rest (random-IV AES-GCM) via the encrypted-fields extension.
  email     String
  /// HMAC-SHA256 search hash of the normalized email — the
  /// duplicate-invite refusal filters on this (via the extension's
  /// where-rewrite; call sites write plain `where: { email }`).
  /// Registered from day one, so no rollout window and no backfill.
  emailHash Bytes?

  /// Role granted on acceptance. OWNER is intentionally not invitable —
  /// there is one OWNER per tenant, set at tenant creation.
  role TenantRole

  /// Random URL-safe token (32 bytes hex). Stored as-is (not hashed):
  /// acceptance is single-use and the token only lets the holder JOIN
  /// the tenant at the stored role, not impersonate an existing member.
  /// If invites ever grant broader scope, switch to hashed-at-rest.
  token String @unique

  status      InviteStatus @default(PENDING)
  /// Who created the invite — the audit trail's originator.
  invitedById String       @db.Uuid
  invitedBy   User         @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?
  revokedAt   DateTime?

  @@index([tenantId, status])
  @@index([tenantId, emailHash])
  @@map("tenant_invite")
}

enum InviteStatus {
  PENDING // outstanding — the accept link works
  ACCEPTED // membership created; link is spent
  REVOKED // admin cancelled before acceptance
  EXPIRED // lazy-flipped when an expired link is followed
}

// ─────────────────────────────────────────────────────────────────────────
// Bank feed (QBO-style "For Review" inbox).
//
// A BankTransaction is a line imported from a bank/card — via CSV today,
// via Plaid later — that has NOT yet hit the ledger. It's a staging record,
// not a posting: the user reviews it, picks a category, and only then does a
// balanced JournalEntry post through postJournalEntry. Excluded lines never
// post. This mirrors the bank-feed mental model every QuickBooks user has
// (For Review → Add/Exclude → count to zero), and keeps the import path
// strictly separate from the ledger so a bad feed can't dirty the books.
// ─────────────────────────────────────────────────────────────────────────
model BankTransaction {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Scope. A feed belongs to one (entity, book) just like everything else.
  entityId String      @db.Uuid
  entity   LegalEntity @relation(fields: [entityId], references: [id])
  bookId   String      @db.Uuid
  book     Book        @relation(fields: [bookId], references: [id])

  // The bank/card GL account this line came from — the fixed side of the
  // eventual JE. Must be a real account (isBank is the usual case).
  bankAccountId String  @db.Uuid
  bankAccount   Account @relation("BankTxnBankAccount", fields: [bankAccountId], references: [id])

  postedDate  DateTime @db.Date
  // Merchant / memo as the bank sent it. Encrypted at rest (Confidentiality
  // TSC) — bank descriptions are as sensitive as anything in the ledger.
  description String
  // Signed in the ACCOUNT HOLDER's frame: positive = money into the account
  // (a deposit / refund), negative = money out (a payment / charge). This is
  // the sign convention nearly every bank CSV uses, so it needs no flip on
  // import; the JE posting derives debit/credit from it per the account's
  // normal side.
  amount      Decimal  @db.Decimal(18, 4)
  externalRef String? // bank's own transaction id, when the export carries one

  // Idempotency. A content hash of (bankAccountId, postedDate, amount,
  // normalized description, externalRef), computed on PLAINTEXT before the
  // description is encrypted, so re-importing the same CSV is a no-op rather
  // than a duplicate — exactly how QBO refuses to double-import a feed.
  dedupeHash String

  status BankTxnStatus @default(FOR_REVIEW)

  // Set when the line is categorized: the category account chosen and the
  // JournalEntry that posted. Null while FOR_REVIEW or EXCLUDED.
  categoryAccountId String?       @db.Uuid
  categoryAccount   Account?      @relation("BankTxnCategory", fields: [categoryAccountId], references: [id])
  // Unique (nullable → Postgres allows many NULLs, so unclaimed lines are
  // unconstrained): at most one bank line may point at a given posted
  // entry. This is the DB-level backstop for the match/categorize race —
  // a second concurrent claim on the same entry fails with P2002 instead
  // of silently double-linking.
  postedEntryId     String?       @unique @db.Uuid
  postedEntry       JournalEntry? @relation(fields: [postedEntryId], references: [id])

  // EXCLUDE audit — who dismissed it and why (a personal charge on a
  // business card, a duplicate the bank re-sent, etc.).
  excludedBy    String?
  excludeReason String?

  importedAt DateTime @default(now())
  createdBy  String?

  // One row per real bank line, per tenant. Full unique (not partial) so
  // `prisma db push` creates it without a migration-mirror entry.
  @@unique([tenantId, dedupeHash])
  @@index([tenantId, entityId, bookId, bankAccountId, status])
  @@map("bank_transaction")
}

enum BankTxnStatus {
  FOR_REVIEW
  CATEGORIZED
  // Linked to an EXISTING journal entry instead of posting a new one —
  // the books already recorded this money (a manual JE, a recurring
  // posting), so the feed line just claims it. No entry is created.
  MATCHED
  EXCLUDED
}

// A learned categorization rule for the bank feed. Created automatically
// each time a line is categorized: next time a line's normalized merchant
// text contains this rule's matchText, the inbox pre-selects the category
// (suggestion only — nothing posts without the user's Add). This is QBO's
// learning matcher, minus auto-add, which stays a later, opt-in step.
model BankRule {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Normalized merchant text (lowercased, digit-runs stripped — see
  // normalizeMerchant). Encrypted at rest like the descriptions it derives
  // from; matching happens in application code over the tenant's decrypted
  // rules, never in SQL.
  matchText String
  // Plain SHA-256 of the normalized matchText, for the uniqueness the
  // encrypted column can't provide (random IV → different ciphertext per
  // write). Same tradeoff as BankTransaction.dedupeHash and accepted for
  // the same reason: uniqueness needs determinism.
  matchHash String

  // Optional: restrict the rule to lines from one bank account (a payee
  // that should be Groceries from the card but Reimbursable from Checking).
  bankAccountId String?  @db.Uuid
  bankAccount   Account? @relation("BankRuleBankAccount", fields: [bankAccountId], references: [id])

  categoryAccountId String  @db.Uuid
  categoryAccount   Account @relation("BankRuleCategory", fields: [categoryAccountId], references: [id])

  // Learning weight: bumped every time a categorize confirms this rule's
  // merchant→category pairing. When two rules both match, higher wins.
  timesUsed  Int      @default(1)
  lastUsedAt DateTime @default(now())
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([tenantId, matchHash])
  @@index([tenantId])
  @@map("bank_rule")
}
