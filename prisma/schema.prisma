model RevenueContractBookAttributes {
  contractId String          @db.Uuid
  contract   RevenueContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  bookId     String          @db.Uuid
  book       Book            @relation(fields: [bookId], references: [id])

  // GAAP/IFRS use ACCRUAL (ASC 606). Tax may use CASH for certain entities.
  recognitionBasis     RecognitionBasis @default(ACCRUAL)
  cumulativeRecognized Decimal          @default(0) @db.Decimal(18, 4)

  @@id([contractId, bookId])
  @@map("revenue_contract_book_attributes")
}

enum RecognitionBasis {
  ACCRUAL
  CASH
}

// =========================================================================
// Ownership, queues, audit log, and reassignment rules engine
// =========================================================================
//
// Universal ownership: every transactional record gets ownerId (User OR Queue,
// discriminated by ownerType), defaults to createdBy at insert, mutable only
// via explicit reassignment. Audit columns (createdBy, updatedBy, updatedAt)
// are separate and immutable-or-write-only. See docs/ownership-and-rules.md.
//
// Sharing semantics in ERP modules: ownerId is for workflow routing and "my
// queue" views, NOT for access control. Module/operation permissions and
// entity/book scope handle sharing. Future CRM modules MAY use ownership as
// a sharing primitive following Salesforce conventions — that's a per-module
// choice and must be documented when those modules land.

enum OwnerType {
  USER
  QUEUE
}

// ownerId is polymorphic (User OR Queue, discriminated by ownerType), so
// JournalEntry doesn't have a real FK relation to User — only ownerType=USER
// rows point at User.id. The application enforces the polymorphic invariant.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String    @unique
  // SOC 2 CC6 — Confidentiality TSC. HMAC-SHA256 search-hash for
  // the encrypted `email` column. Populated by the encrypted-fields
  // Prisma extension on write; queried by `emailLookupKeyForUser`
  // (see src/lib/soc2/index.ts) on every login + admin email
  // lookup. See docs/design/deterministic-encryption.md.
  //
  // Nullable during the Phase 2 rollout window so existing pre-
  // rollout rows (with NULL hash) don't block writes. Backfill via
  // scripts/encrypt-user-emails.ts. Tightened to NOT NULL in the
  // Phase 3 cleanup PR once every row has a hash.
  emailHash     Bytes?    @unique
  displayName   String
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?

  // Multi-tenancy: a User can belong to N Tenants via TenantMembership.
  // User itself is global (no tenantId) — login lookup is global by email.
  tenantMemberships TenantMembership[]

  queueMemberships   QueueMember[]
  recordEvents       RecordEvent[]
  notifications      Notification[] @relation("NotificationRecipient")
  notificationsActed Notification[] @relation("NotificationActor")
  auditEvents        AuditLog[]     @relation("AuditLogActor")
  journalEntryNotes  JournalEntryNote[]
  invitesSent        TenantInvite[] @relation("InvitedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_user")
}

model Queue {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @db.Uuid
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Phase 4b: unique per tenant. Each tenant defines its own queue codes.
  code                 String // e.g. "AR_COLLECTIONS", "GL_UNASSIGNED"
  name                 String
  description          String?
  // When isUnassignedFallback is true, this queue is the module's dead-letter
  // queue — rules fall back to it when their primary target can't resolve.
  // Exactly one queue per module should carry this flag.
  isUnassignedFallback Boolean   @default(false)
  isActive             Boolean   @default(true)
  deletedAt            DateTime?

  members QueueMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("queue")
}

model QueueMember {
  queueId String @db.Uuid
  queue   Queue  @relation(fields: [queueId], references: [id])
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@id([queueId, userId])
  @@map("queue_member")
}

// Universal audit log for ownership changes + state-machine transitions.
// One row per event; append-only; never edited or deleted.
//
// recordType is a stable string matching the Prisma model name
// ("JournalEntry", "ArOpenItem", etc.). recordId is the target record's UUID.
// previousValue + newValue are flexible JSON to handle different event shapes
// (owner change carries ownerId; state change carries status; etc.).
model RecordEvent {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String          @db.Uuid
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recordType    String // e.g. "JournalEntry"
  recordId      String          @db.Uuid
  eventType     RecordEventType
  previousValue Json?
  newValue      Json?
  actorUserId   String?         @db.Uuid
  actor         User?           @relation(fields: [actorUserId], references: [id])
  // For rule-fired events: "rule:<ruleId>:v<version>". For manual:
  // "manual:<freeform>". For lifecycle: "lifecycle:<event>".
  actorReason   String

  // Specific backrefs per ownership-bearing model; add as adoption grows.
  // Multiple FK columns rather than polymorphic — one is set per row based
  // on recordType, the others are null. Indexed by (recordType, recordId)
  // for queries that don't care about which model.
  journalEntryId String?       @db.Uuid
  journalEntry   JournalEntry? @relation("JournalEntryEvents", fields: [journalEntryId], references: [id])
  arOpenItemId   String?       @db.Uuid
  arOpenItem     ArOpenItem?   @relation("ArOpenItemEvents", fields: [arOpenItemId], references: [id])
  apOpenItemId   String?       @db.Uuid
  apOpenItem     ApOpenItem?   @relation("ApOpenItemEvents", fields: [apOpenItemId], references: [id])

  occurredAt DateTime @default(now())

  @@index([recordType, recordId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("record_event")
}

enum RecordEventType {
  CREATED
  OWNER_CHANGED
  STATE_CHANGED
  REASSIGNMENT_LOCKED
  REASSIGNMENT_UNLOCKED
  ABANDONED
}

// AuditLog — security & access events.
//
// Complements RecordEvent (which tracks state changes on tracked records).
// AuditLog records the events SOC 2 CC6/CC7 auditors expect to see:
//   - Login + logout + access denials
//   - Privileged actions (period close, user lifecycle changes, admin reset)
//   - Internal-API token use (success + rejection)
//   - Data exports (CSV/PDF downloads)
//   - Configuration changes
//   - Anomalies the system itself catches
//
// Designed for long retention (12+ months for SOC 2). The actorEmail
// column duplicates the join target so the log survives a User row
// deletion — auditors expect immutability of the trail.
//
// metadata is intentionally Json — different event types carry different
// shapes. Conventions documented in src/lib/audit/log.ts.
model AuditLog {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // tenantId is critical for tenant-scoped events (PRIVILEGED_ACTION,
  // JE posts, DATA_EXPORT, etc.) — cross-tenant audit log visibility
  // would leak which actions other firms took. Quarterly access reviews
  // scope by tenant.
  //
  // Intentionally NULLABLE so pre-identity events (TOKEN_REJECTED with
  // garbage Bearer, missing Bearer, malformed token) can still be logged
  // without forcing a synthetic tenant assignment. These platform-level
  // events are visible only to platform admins (default-tenant owner).
  // Phase 4b kept this column nullable; every other tenant-scoped table
  // is NOT NULL.
  tenantId    String?        @db.Uuid
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventType   AuditEventType
  // Who: actor (when known) + denormalized email + network identity
  actorUserId String?        @db.Uuid
  actor       User?          @relation("AuditLogActor", fields: [actorUserId], references: [id])
  // Captured separately so the log survives a User deletion. Required
  // for actor-identifiable events (LOGIN_*, PRIVILEGED_ACTION, etc.);
  // null for system events (CONFIG_CHANGE on boot, etc.).
  actorEmail  String?
  // From x-forwarded-for (Vercel) or remoteAddress. Best-effort; clients
  // can spoof. Required reading for unusual-access investigations.
  ipAddress   String?
  userAgent   String?
  // What: resource + action
  // resource is a stable string ("JournalEntry", "Period", "User",
  // "FixedAsset", "DepreciationRun", etc.). resourceId is the target
  // record's code or UUID (whichever's more readable in the log).
  resource    String?
  resourceId  String?
  // action is free-form verbal: "post", "close", "reopen", "deactivate",
  // "download-csv", "view-report", "issue-token", etc. Match action
  // names to the Server Action / endpoint that wrote the log entry.
  action      String
  outcome     AuditOutcome   @default(SUCCESS)
  // Context: structured fields the event-type expects. See
  // src/lib/audit/log.ts for the convention per event type.
  metadata    Json?
  occurredAt  DateTime       @default(now())

  // Indexes drive the common audit queries:
  //   - "What did Carla do this week?" → (actorUserId, occurredAt)
  //   - "Show me all login failures last 30 days" → (eventType, occurredAt)
  //   - "Who accessed JE NORTHWIND-US_GAAP-00042?" → (resource, resourceId)
  @@index([actorUserId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([resource, resourceId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("audit_log")
}

enum AuditEventType {
  LOGIN_SUCCESS // setCurrentUser succeeded
  LOGIN_FAILURE // setCurrentUser rejected (unknown user, inactive)
  LOGOUT // clearCurrentUser
  ACCESS_DENIED // requireAdmin failed; non-admin tried admin action
  PRIVILEGED_ACTION // period close, user lifecycle, admin reset, etc.
  DATA_EXPORT // CSV/PDF download, bulk read
  DATA_ERASURE // GDPR Art. 17 right-to-erasure events
  TOKEN_USED // /api/internal/* request authenticated via INTERNAL_API_TOKEN
  TOKEN_REJECTED // /api/internal/* request failed Bearer-token check
  CONFIG_CHANGE // env-var change, schema migration applied
  SECURITY_EVENT // anything anomalous: rate-limit hit, repeated failures, etc.
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  ANOMALOUS
}

// Reassignment rules. Versioned + audited, same discipline as PostingRule.
// criteriaJson holds the DSL tree (see src/lib/rules/types.ts for the shape).
// First-match-wins by priority (lower = earlier). Validated at write time
// via src/lib/rules/validator.ts.
model ReassignmentRule {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String               @db.Uuid
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ruleId                String // human-readable, stable across versions
  ruleVersion           Int                  @default(1)
  recordType            String // "JournalEntry", "ArOpenItem", etc.
  trigger               ReassignmentTrigger
  // For ON_UPDATE: which fields changing should re-evaluate this rule.
  // Empty array = evaluate on any field change (use sparingly).
  triggerFields         String[]             @default([])
  // For ON_STATE_TRANSITION: which (from, to) state pair.
  triggerStateFrom      String?
  triggerStateTo        String?
  // For ON_USER_LIFECYCLE: which event triggers ("USER_DEACTIVATED", "ROLE_REMOVED").
  triggerLifecycleEvent String?
  // For ON_SCHEDULE: cron expression (UTC).
  triggerSchedule       String?
  priority              Int // lower fires earlier; ties = validation error
  // For declarative rules.
  criteriaJson          Json?
  // For code rules. References a function name registered in
  // src/lib/rules/registry.ts. NOT user-editable — code review required.
  ruleType              ReassignmentRuleType @default(DECLARATIVE)
  codeImplementation    String?
  // Target: USER, QUEUE, or DERIVED (code-rule decides at evaluation time).
  targetType            OwnerType?
  targetId              String?              @db.Uuid
  // Notification preferences (optional).
  notifyOwner           Boolean              @default(false)
  notifyTarget          Boolean              @default(true)
  notifyTemplateId      String?

  isActive     Boolean   @default(true)
  authoredBy   String?
  authoredAt   DateTime  @default(now())
  supersededAt DateTime?

  @@unique([ruleId, ruleVersion])
  @@index([recordType, isActive, priority])
  @@index([tenantId])
  @@map("reassignment_rule")
}

enum ReassignmentRuleType {
  DECLARATIVE
  CODE
}

enum ReassignmentTrigger {
  ON_INSERT
  ON_UPDATE
  ON_STATE_TRANSITION
  ON_SCHEDULE
  ON_USER_LIFECYCLE
}

// User-facing notifications. Emitted by the rules engine + reassignment
// service to surface "something happened" — e.g., "A new $25K AR item
// was assigned to your queue."
//
// Recipient is always a USER (not a queue). When a record is assigned
// to a queue, the notification emitter fans out one row per queue
// member. This is intentionally simple — production systems would add
// per-user preferences (mute, batch, route to email/Slack) but this is
// the substrate those layer on.
//
// link is a relative URL the bell dropdown opens (e.g., "/ar" or
// "/journal-entries/abc"). recordType + recordId let the bell group
// multiple notifications for the same target.
model Notification {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String @db.Uuid
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recipientUserId String @db.Uuid
  recipient       User   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  category NotificationCategory
  title    String
  body     String?
  link     String?

  // Audit: who/what triggered this notification.
  // sourceRuleId references a ReassignmentRule.ruleId (string, since
  // rules are versioned and we want to track which rule version fired).
  // actorUserId is the User who took the action (manual reassignment)
  // or null for engine-fired notifications.
  sourceRuleId String?
  actorUserId  String? @db.Uuid
  actor        User?   @relation("NotificationActor", fields: [actorUserId], references: [id])

  // Target record. Lets the bell group repeated notifications about
  // the same record and link to its detail page.
  recordType String?
  recordId   String? @db.Uuid

  seenAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([recipientUserId, seenAt, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([tenantId, createdAt])
  @@map("notification")
}

enum NotificationCategory {
  REASSIGNMENT // record's owner changed (manual or rule-fired)
  APPROVAL_NEEDED // record is in your queue awaiting action
  ORPHAN_DETECTED // a record you previously owned is now an orphan
  SYSTEM // catch-all for engine-level events
}

// =========================================================================
// DB-level invariants live in prisma/migrations/0001_constraints/migration.sql
// =========================================================================
//
//   - JournalLine: (debit > 0 AND credit = 0) OR (debit = 0 AND credit > 0)
//   - JournalLine: debit >= 0 AND credit >= 0
//   - JournalEntry: a POSTED entry must reference a non-CLOSED PeriodClose
//     (enforced in posting function; DB check is per-(entity,book,period)
//     and requires a deferrable trigger; out of scope for the first commit).
//
// See docs/universal-schema.md for the architectural rationale and the
// remaining layers' build plan.
